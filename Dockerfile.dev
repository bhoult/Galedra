# Development image used by docker-compose.yml. The production image is Dockerfile.
FROM ruby:4.0.7-slim

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends build-essential git libpq-dev libvips libyaml-dev pkg-config curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV BUNDLE_PATH=/usr/local/bundle

COPY Gemfile Gemfile.lock ./
RUN bundle install

COPY . .

EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0"]

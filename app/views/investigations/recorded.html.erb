<% content_for :title, "Recorded" %>
<div class="paste">
  <h1>Recorded</h1>
  <div class="card"><p><strong>Share this check:</strong> <%= link_to @result[:share][:url], @result[:share][:url] %></p><p class="meta">Paste it where you were going to post. It shows what was asked and Galedra's answer, and stays current as evidence arrives.</p></div>
  <p class="meta"><%= pluralize(@result[:contributions], "signed contribution") %> appended at snapshot <%= @result[:snapshot_seq] %> · <%= pluralize(@result[:tasks_opened], "verification task") %> opened · provisional until audited</p>
  <% @result[:claims].each do |c| %>
    <div class="card answer">
      <p class="claim">“<%= Claim.find(c[:id]).canonical_text %>”</p>
      <p class="headline"><%= c[:card][:plain][:headline] %></p>
      <% if c[:card][:plain][:say_instead] %><p><strong>Say instead:</strong> <%= c[:card][:plain][:say_instead] %></p><% end %>
      <p class="meta"><%= c[:card][:headline] %> under <%= c[:card][:model] %> · review checks <%= c[:card][:review_checks] %><% unless c[:created] %> · attached to an existing claim<% end %></p>
      <p><%= link_to "See the evidence", claim_path(c[:id]) %> · <%= link_to "Share card", card_claim_path(c[:id]) %></p>
    </div>
  <% end %>
  <p><%= link_to "Record another", new_investigation_path %></p>
</div>

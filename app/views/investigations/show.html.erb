<% content_for :title, "Checked in Galedra" %>
<% content_for :head do %>
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="Galedra">
  <meta property="og:title" content="<%= @summary[:headline] %>">
  <meta property="og:description" content="<%= [ "“#{@investigation.statement.presence || @claims.first&.canonical_text}”", "Checked in Galedra, an epistemic ledger. Provisional until audited." ].join(" ") %>">
  <meta property="og:url" content="<%= investigation_url(@investigation) %>">
  <meta property="og:image" content="<%= card_investigation_url(@investigation, format: :png) %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="<%= card_investigation_url(@investigation, format: :png) %>">
<% end %>
<div class="share">
  <p class="eyebrow">Checked, not settled</p>
  <% top = Cards::Badge.for_key(@summary[:badge]) %>
  <div class="card answer badged">
    <figure class="badge-validity" style="color: <%= top[:color] %>"><%= Cards::Badge.svg(top[:key], size: 56) %><figcaption class="badge-label"><%= top[:label] %></figcaption></figure>
    <p class="claim-text">“<%= @investigation.statement.presence || @claims.first&.canonical_text %>”</p>
    <% if @summary[:detail].present? %><p><strong><%= @summary[:headline] %></strong> <%= @summary[:detail] %>.</p><% end %>
    <% if @summary[:stated] %><p class="meta"><%= @summary[:stated] %>. <%= @claims.size > 1 ? @verdict[:note] : "The number is model-conditional, not a share of truth." %></p><% end %>
    <p class="meta"><%= @claims.size > 1 ? "The statement as a whole, read from the #{@claims.size} claims below. Each claim is scored on its own; this reading only counts them." : "What was asked, and where it stands." %> Provisional until audited.</p>
    <p><strong>Share:</strong> <code><%= @share_line %></code></p>
  </div>
  <% if @claims.size > 1 %><h2>Claim by claim</h2><% end %>
  <% @claims.each do |claim| %>
    <% card = @cards[claim.id] %>
    <% badge = Cards::Badge.for(@results[claim.id].assessment_state, @results[claim.id].probability) %>
    <div class="card answer badged">
      <figure class="badge-validity" style="color: <%= badge[:color] %>"><%= Cards::Badge.svg(badge[:key], size: 56) %><figcaption class="badge-label"><%= badge[:label] %></figcaption></figure>
      <p class="claim-text">“<%= claim.canonical_text %>”</p>
      <% if card[:plain][:say_instead] %><p class="say-instead"><strong>Say instead:</strong> <%= card[:plain][:say_instead] %></p><% end %>
      <p class="meta"><%= card[:headline] %><% if card[:stated] %> · <%= card[:stated] %><% end %> · review checks <%= card[:review_checks] %> · provisional until audited. The number is model-conditional, not a share of truth.</p>
      <p><%= link_to "See the evidence", claim_path(claim) %> · <%= link_to "Claim card", card_claim_path(claim) %></p>
    </div>
  <% end %>
  <% if @sources.any? %>
    <h2>Sources read</h2>
    <ul><% @sources.each do |s| %><li><%= link_to s.title, source_path(s) %><% if s.canonical_uri.present? %> · <%= safe_source_link(s.canonical_uri) %><% end %></li><% end %></ul>
  <% end %>
  <p class="meta">Recorded at snapshot <%= @investigation.snapshot_seq %>; this page reads the current state of each claim. <%= link_to "What Galedra is", root_path %>.</p>
</div>

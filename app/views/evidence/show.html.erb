<% content_for :title, "Evidence" %>
<h1>Evidence item</h1>
<div class="card">
  <p><strong><%= @evidence[:statement] || "[withheld]" %></strong> <span class="badge"><%= @evidence[:observation_type] %></span></p>
  <p class="meta">Authenticity <%= @evidence[:assessment]["authenticity"] %> · extraction <%= @evidence[:assessment]["extraction"] %> · independence group <%= @evidence[:independence_group_id] ? short_id(@evidence[:independence_group_id]) : "none (unreviewed)" %> · <%= link_to "created seq #{@item.created_seq}", contribution_path(@item.contribution_id) %></p>
  <p>Source: <%= link_to @evidence[:source][:title] || "[withheld]", source_path(@evidence[:source][:id]) %> · locator <code><%= @evidence[:source_location][:locator].to_json %></code> · excerpt hash <code><%= @evidence[:source_location][:excerpt_hash] %></code></p>
  <% if @evidence[:source_location][:excerpt] %><details><summary>Exact excerpt</summary><pre><%= @evidence[:source_location][:excerpt] %></pre></details><% end %>
</div>
<h2>Linked claims</h2>
<table><tr><th>Claim</th><th>Direction</th><th>Relevance</th><th>Steps</th><th>Counted</th></tr>
<% @evidence[:links].each do |l| %><tr><td><%= link_to short_id(l[:claim_id]), claim_path(l[:claim_id]) %></td><td><%= l[:direction] %></td><td><%= l[:relevance_strength] %></td><td><%= l[:interpretive_steps] %></td><td><%= l[:counted] ? "yes" : "no" %></td></tr><% end %></table>
<h2>Audits</h2>
<% if @audits.any? %><table><tr><th>seq</th><th>result</th><th>auditor</th></tr><% @audits.each do |a| %><tr><td><%= a.created_seq %></td><td><%= a.result %></td><td><%= link_to short_id(a.auditor.key_id), contributor_path(a.auditor) %></td></tr><% end %></table>
<% else %><p class="muted">None.</p><% end %>

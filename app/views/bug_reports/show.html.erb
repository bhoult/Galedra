<% content_for :title, "Bug report" %>
<p class="meta"><%= link_to "Bug reports", bug_reports_path %> › <%= @row.created_at.utc.strftime("%Y-%m-%d %H:%M") %> UTC</p>
<h1>Bug report</h1>
<div class="card">
  <p class="meta">
    <strong><%= @row.status.downcase %></strong> ·
    filed <%= @row.created_at.utc.strftime("%Y-%m-%d %H:%M") %> UTC<%= " · last seen #{@row.updated_at.utc.strftime('%Y-%m-%d %H:%M')} UTC" if @row.count > 1 %> ·
    reported <%= pluralize(@row.count, "time") %> ·
    from <%= @row.reporter %>
  </p>
</div>



<h2>What happened</h2>
<div class="card"><%= simple_format(@row.happened) %></div>

<% if @row.expected.present? %>
  <h2>What was expected</h2>
  <div class="card"><%= simple_format(@row.expected) %></div>
<% end %>

<% if @row.steps.present? %>
  <h2>Steps</h2>
  <div class="card"><%= simple_format(@row.steps) %></div>
<% end %>

<% if @row.url.present? || @row.context_tool.present? || @row.last_error.present? %>
  <h2>Where</h2>
  <div class="card">
    <% if @row.url.present? %><p><strong>Page</strong> <code><%= @row.url %></code></p><% end %>
    <% if @row.context_tool.present? %><p><strong>While using</strong> <code><%= @row.context_tool %></code></p><% end %>
    <% if @row.last_error.present? %><p><strong>Last error</strong> <code><%= @row.last_error %></code></p><% end %>
  </div>
<% end %>

<%= render "shared/report_thread", row: @row %>

<%= render "shared/triage_actions", row: @row %>

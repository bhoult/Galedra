<% content_for :title, "Task" %>
<h1>Task: <%= @task.task_type %></h1>
<div class="card">
  <p class="meta">Domain <%= @task.domain %> · priority <%= @task.priority.to_s("F") %> · estimated cost <%= @task.spec[:cost] %> · required assignments <%= @task.required_assignments %> · status <%= @task.status %> · audit requirement: sampled per <%= Audits::Policy.version %>, provisional until audited CONFIRMED</p>
  <p>Target: <% if @target.is_a?(Claim) %><%= link_to @target.canonical_text, claim_path(@target) %><% elsif @target.is_a?(Inference) %>inference concluding <%= link_to @target.conclusion.canonical_text, claim_path(@target.conclusion, anchor: "inferences") %><% else %><%= link_to @target.title, source_path(@target) %><% end %></p>
  <p><strong>Hand this to my agent:</strong></p>
  <pre>ruby examples/agent/agent.rb run --base-url <%= request.base_url %> --key-file agent-key.json --delegation &lt;delegation id&gt; --types <%= @task.task_type %> --domains <%= @task.domain %> --once</pre>
</div>
<% if @task.task_type == "EVIDENCE_VERIFICATION" && (finding = SourceRetrieval.latest_for(@task.packet.dig("context", "source_id"))&.finding_for(@task.packet.dig("context", "source_location_id"))) %>
  <p class="meta">Galedra's own fetch of the page found the quoted passage: <strong><%= finding.downcase.tr("_", " ") %></strong>. A fact for the reviewer to weigh, not a verdict.</p>
<% end %>
<details><summary>Signed packet</summary><pre><%= JSON.pretty_generate(@task.packet) %></pre></details>
<% if @task.closed? %>
  <h2>Results</h2>
  <%# The search's coverage shows here rather than on the claim, because results
      stay blind until every slot is in and a null's coverage is as much of a
      result as a finding is. %>
  <ul><% @task.submitted_assignments.each do |a| %>
    <li><%= link_to "result by #{short_id(a.contributor.key_id)}", contribution_path(a.result_contribution_id) %>
      <% if (note = Contribution.find_by(id: a.result_contribution_id)&.payload.to_h["searched"]).present? %>
        <p class="meta"><strong>What the search covered</strong> — untrusted text, and no part of any score.</p>
        <blockquote><%= simple_format(note) %></blockquote>
      <% end %>
    </li>
  <% end %></ul>
<% else %><p class="muted">Results are revealed once every slot is submitted or leases expire (blind independent verification).</p><% end %>

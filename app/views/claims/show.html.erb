<% content_for :title, "Claim" %>
<% if @quarantine %>
  <h1>Quarantined claim</h1>
  <div class="card">
    <p class="headline">Quarantined</p>
    <p>This claim's text is withheld. Quarantined at seq <%= @quarantine.created_seq %> by moderator key <code><%= @quarantine.contribution.signer_key_id %></code>, reason <strong><%= @quarantine.reason %></strong>.</p>
    <p>Appeal status: <%= @quarantine.released? ? "released" : "open" %> · <%= link_to "moderation log", moderation_path %></p>
  </div>
<% else %>
  <% if @section %>
    <% outline_tree = Sections::Tree.call(@section.root, @seq, model: @model) %>
    <% open_ids = ([ @section ] + @section.ancestors(@seq)).map(&:id) %>
  <% end %>
  <div class="<%= 'with-outline' if @section %>">
  <% if @section %>
    <aside class="outline tree">
      <h2><%= link_to @section.root.heading, section_path(@section.root) %></h2>
      <%= render "sections/tree", node: outline_tree, open_ids: open_ids, current_claim: @claim.id, seq: @seq %>
      <% if @sections.size > 1 %><p class="meta">Also in: <% (@sections - [ @section ]).each do |s| %><%= link_to s.heading, claim_path(@claim, section: s.id) %> <% end %></p><% end %>
    </aside>
  <% end %>
  <div>
  <h1>Claim</h1>
  <% if @revision[:superseded_by] %>
    <div class="card"><p class="headline">Revised</p><p>Superseded at seq <%= @revision[:superseded_by][:seq] %> by <%= @revision[:superseded_by][:by] %>: <%= link_to @revision[:superseded_by][:text], claim_path(@revision[:superseded_by][:claim_id]) %><% if @revision[:superseded_by][:reason] %> · reason: <%= @revision[:superseded_by][:reason] %><% end %>. This entry stays in the log; the current claim is the revision.</p></div>
  <% elsif @revision[:merged_into] %>
    <div class="card"><p class="headline">Merged</p><p>Merged at seq <%= @revision[:merged_into][:seq] %> into <%= link_to "another claim", claim_path(@revision[:merged_into][:claim_id]) %>.</p></div>
  <% end %>
  <div class="card">
    <p><strong><%= @claim.canonical_text || "[redacted]" %></strong></p>
    <p class="meta">Type <%= @claim.claim_type %> · truth-evaluable: <%= @evaluable ? "yes" : "no (#{@reason})" %> · status at snapshot: <%= @claim.status_at(@seq) %> · <%= link_to "created seq #{@claim.created_seq}", contribution_path(@claim.contribution_id) %>
      <% if @claim.qualifiers.present? %>· qualifiers <code><%= @claim.qualifiers.to_json %></code><% end %></p>
    <% @warnings.each do |w| %><span class="warning"><%= w[:detail] %></span><% end %>
    <% if @references && @references["total"].positive? %><p class="meta">Referenced <%= pluralize(@references["total"], "time") %>: checked <%= @references["CHECKED"] %>, looked up by assistants <%= @references["LOOKED_UP"] %>, viewed <%= @references["VIEWED"] %>, shared <%= @references["SHARED"] %>. A count of attention, not evidence.</p><% end %>
    <% if @revision[:revises] %><p class="meta">Revises <%= link_to @revision[:revises][:text], claim_path(@revision[:revises][:claim_id]) %><% if @revision[:revises][:reason] %> · reason: <%= @revision[:revises][:reason] %><% end %></p><% end %>
  </div>

  <% if @proposals.any? %>
    <h2>Proposed corrections</h2>
    <table><tr><th>seq</th><th>Proposal</th><th>By</th><th></th></tr>
    <% @proposals.each do |x| %>
      <tr><td><%= link_to x[:seq], contribution_path(x[:contribution_id]) %></td><td><%= x[:summary] %></td><td><%= x[:proposed_by] %></td>
        <td><% if @acceptable.include?(x[:contribution_id]) %><%= button_to "Accept", accept_claim_path(@claim, contribution_id: x[:contribution_id]), class: "secondary" %><% else %><span class="muted">awaits the claim's principal</span><% end %></td></tr>
    <% end %></table>
    <p class="meta">A proposal takes effect once the principal of this claim (or a moderator) accepts it; leaving it here declines it. Every acceptance is a signed contribution.</p>
  <% end %>

  <%= render "shared/selectors", url: claim_path(@claim), seq: @seq, extra_params: {} %>

  <%= render "claims/topics", claim: @claim, topics: @topics %>

  <% if @card %>
    <h2>Assessment</h2>
    <%= render "shared/card", card: @card %>

    <details id="why">
      <summary>Why?</summary>
      <div class="card">
        <% if @why[:strongest_support] %><p><strong>Strongest counted support:</strong> <%= @why[:strongest_support][:statement] %> <span class="badge">weight <%= @why[:strongest_support][:effective_weight] %></span> <%= link_to "evidence", evidence_path(@why[:strongest_support][:evidence]) %></p><% end %>
        <% if @why[:strongest_contradiction] %><p><strong>Strongest counted contradiction:</strong> <%= @why[:strongest_contradiction][:statement] %> <span class="badge">weight <%= @why[:strongest_contradiction][:effective_weight] %></span> <%= link_to "evidence", evidence_path(@why[:strongest_contradiction][:evidence]) %></p><% end %>
        <% if @why[:suppressed_dependents].any? %><p><strong>Suppressed as dependent:</strong> <%= @why[:suppressed_dependents].map { |s| s[:statement] }.join("; ") %></p><% end %>
        <% if @why[:review_gaps].any? %><p><strong>Review gaps:</strong> <%= @why[:review_gaps].map { |g| g.tr("_", " ") }.join(", ") %></p><% end %>
        <% if @why[:what_would_most_change_this] %><p><strong>What would most change this:</strong> <%= @why[:what_would_most_change_this][:text] %></p><% end %>
      </div>
    </details>

    <% if @show_calculation %>
      <p><%= link_to "Hide calculation", claim_path(@claim, model: params[:model], snapshot_seq: params[:snapshot_seq]) %></p>
      <div class="card" id="calculation">
        <% number = assessment_number(@assessment) %>
        <% if number %>
          <p><strong><%= number %></strong> · state <%= state_label(@assessment[:assessment_state]) %> · <%= review_checks_text(@assessment[:review_checklist]) %> · stability <%= @assessment[:stability] %> · <%= evidence_counts_text(@evidence[:counted].size, @assessment[:support_groups] + @assessment[:contradict_groups]) %></p>
        <% else %>
          <p><strong>No probability.</strong> <%= @assessment[:assessment_state] == "NOT_APPLICABLE" ? not_applicable_text(@assessment[:not_applicable_reason]) : "No counted evidence bears on this claim at this snapshot." %></p>
        <% end %>
        <p class="meta">Model <%= @assessment[:model] %> (<%= @model == Scoring::Registry.default_model ? "the default model, not the answer" : "an alternative model" %>) · snapshot <%= @assessment[:snapshot_seq] %> · trace <code><%= @assessment[:trace_hash] %></code></p>
        <%# Stage 38: this was computed once, at the entry that last bore on the
            claim, and reused since. Saying so is more use than a number
            recomputed at a snapshot where nothing had changed. %>
        <% if @assessment[:unchanged_since] %>
          <p class="meta">Last changed at entry <%= seq_link(@assessment[:unchanged_since]) %>; nothing logged since has borne on this claim.</p>
        <% end %>
        <%# The arithmetic itself. "Show calculation" used to show the result and
            the trace hash, which is the inputs and the answer with the working
            left out (owner, 2026-09-22). Every number below is read from the
            trace and the model's config; none of it is computed here. %>
        <% if @calculation %>
          <h3>How the number was reached</h3>
          <% if @calculation[:links].any? %>
            <p class="meta">Each counted link is weighed by multiplying the factors the model declares; a factor it does not declare is not shown. Every factor name below links to <%= link_to "what that number means", scoring_path(model: @assessment[:model]) %>.</p>
            <table class="working">
              <tr><th>Link</th><th>Working</th><th>Weight</th><th>Counted as</th></tr>
              <% @calculation[:links].each do |row| %>
                <tr>
                  <td><%= link_to short_id(row[:link]["link"]), evidence_path(row[:link]["evidence"]) %> <span class="muted"><%= row[:link]["direction"].downcase %></span></td>
                  <%# Named, not just hovered: a tooltip is invisible on a phone
                      and undiscoverable everywhere else, and "0.6 × 0.9" with no
                      words is a number nobody can check (owner, 2026-09-22). %>
                  <td class="factors">
                    <% row[:factors].each_with_index do |f, i| %><%= tag.span(" × ", class: "muted") if i.positive? %><span class="factor"><%= link_to f.name, scoring_path(model: @assessment[:model], anchor: f.name) %> <span class="muted"><%= f.label %></span> <strong><%= f.value %></strong></span><% end %>
                  </td>
                  <td><%= row[:magnitude] %></td>
                  <td>
                    <%= row[:effective_weight] || "—" %>
                    <% if row[:reason] %><span class="muted">(<%= row[:reason].tr("_", " ") %><% if row[:kept] %>, kept <%= short_id(row[:kept]) %><% end %>)</span><% end %>
                  </td>
                </tr>
              <% end %>
            </table>
          <% end %>
          <p class="working-sum">
            prior <%= @calculation[:prior] || "—" %>
            → log-odds <%= @calculation[:prior_log_odds] || "—" %>
            <% if @calculation[:evidence_sum] %>+ <%= @calculation[:evidence_sum] %> (the counted weights)<% end %>
            <% if @calculation[:posterior_log_odds] %>= <%= @calculation[:posterior_log_odds] %><% end %>
            <% if @calculation[:probability] %>→ probability <strong><%= @calculation[:probability] %></strong><% end %>
          </p>
          <% if @calculation[:variants] %>
            <p class="meta">Under neighbouring settings of the same model: <%= @calculation[:variants]["conservative"] %> to <%= @calculation[:variants]["permissive"] %>, a spread of <%= @calculation[:variants]["spread"] %><%= ". The result sits on a rounding boundary" if @calculation[:boundary] %>.</p>
          <% end %>
          <p class="meta">Half-even rounding, six places for weights and four for the probability. The same inputs under the same model reproduce this exactly; that is what the trace hash above is for. <%= link_to "How a score is worked out", scoring_path(model: @assessment[:model]) %> explains every factor, why it is there, and what the model sets it to.</p>
        <% end %>
      </div>
    <% else %>
      <p><%= link_to "Show calculation", claim_path(@claim, model: params[:model], snapshot_seq: params[:snapshot_seq], calculation: 1) %></p>
    <% end %>
  <% end %>

  <h2 id="your-view">Your view</h2>
  <div class="card personal">
    <% if authenticated? %>
      <p class="meta">Yours, not Galedra's: a personal view never changes the assessment above and is never counted as evidence (Article XV).</p>
      <% if @my_view %><p><strong>You <%= @my_view.stance == "AGREE" ? "agree" : "disagree" %></strong><% if @my_view.rationale.present? %>: <%= @my_view.rationale %><% end %> <%= button_to "Remove", claim_view_path(@claim), method: :delete, class: "secondary small", form_class: "inline" %></p><% end %>
      <%= form_with url: claim_view_path(@claim), method: :post, class: "filters" do |f| %>
        <label>Why (optional) <%= f.text_field :rationale, value: @my_view&.rationale, maxlength: PersonalAssessment::MAX_RATIONALE, placeholder: "in your own words" %></label>
        <%= f.button "👍 Agree", name: "stance", value: "AGREE", class: "secondary" %>
        <%= f.button "👎 Disagree", name: "stance", value: "DISAGREE", class: "secondary" %>
      <% end %>
    <% else %>
      <p class="meta"><%= link_to "Sign in", new_session_path %> to register whether you agree or disagree. A view is yours alone and never changes the assessment.</p>
    <% end %>
  </div>

  <h2>Registered views</h2>
  <div class="card personal">
    <% if @views[:total].zero? %>
      <p class="muted">Nobody has registered a view yet.</p>
    <% else %>
      <p><strong><%= @views[:agree] %> agree · <%= @views[:disagree] %> disagree</strong> <span class="muted">(<%= pluralize(@views[:total], "person") %>)</span></p>
      <% if @views[:by_affiliation].any? %>
        <table><tr><th>Affiliation</th><th>Agree</th><th>Disagree</th></tr>
        <% @views[:by_affiliation].each do |r| %><tr><td><%= r[:label] %> <span class="muted">(<%= r[:group] %>)</span></td><td><%= r[:agree] %></td><td><%= r[:disagree] %></td></tr><% end %></table>
      <% end %>
    <% end %>
    <p class="meta"><%= @views[:note] %></p>
  </div>

  <% if @checks.any? %>
    <h2 id="checks">Checked as part of</h2>
    <p class="meta">Statements this claim was broken out of. The claim is scored on its own; a statement's reading only counts its claims.</p>
    <ul>
      <% @checks.each do |check| %>
        <li>
          <%= link_to check.outline? ? section_path(check.section_id) : investigation_path(check) do %>
            “<%= truncate(check.title.to_s, length: 160, separator: " ") %>”
          <% end %>
          <span class="muted">· <%= pluralize(check.claim_ids.size, "claim") %> · <%= check.created_at.utc.strftime("%-d %B %Y") %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
  <h2>Evidence for</h2>
  <%= render "claims/links", links: @evidence[:counted].select { |l| l[:direction] == "SUPPORT" } %>
  <h2>Evidence against</h2>
  <%= render "claims/links", links: @evidence[:counted].select { |l| l[:direction] == "CONTRADICT" } %>
  <h2>Qualifications</h2>
  <%= render "claims/links", links: @evidence[:counted].select { |l| %w[QUALIFY NEUTRAL].include?(l[:direction]) } %>
  <% if @evidence[:pending].any? %><h2>Pending links</h2><%= render "claims/links", links: @evidence[:pending] %><% end %>

  <h2>Suppressed as dependent</h2>
  <% suppressed = @result ? @result.trace["links"].select { |l| l["reason"] == "dependent_strongest_only" } : [] %>
  <% if suppressed.any? %>
    <table><tr><th>Evidence</th><th>Group</th><th>Kept instead</th></tr>
    <% suppressed.each do |l| %><tr><td><%= link_to short_id(l["evidence"]), evidence_path(l["evidence"]) %></td><td><%= short_id(l["group"]) %></td><td><%= short_id(l["kept"]) %></td></tr><% end %></table>
  <% else %><p class="muted">None.</p><% end %>

  <h2 id="inferences">Inferences</h2>
  <% [ [ "Concluded from", @inferences[:concluded_from] ], [ "Used as a premise in", @inferences[:premise_in] ] ].each do |title, list| %>
    <h3><%= title %></h3>
    <% if list.empty? %><p class="muted">None.</p><% else %>
      <% list.each do |inf| %>
        <div class="card">
          <p><strong><%= inf[:conclusion][:text] %></strong> <span class="badge"><%= inf[:inference_type] %></span> <span class="badge">self-assessed: <%= inf[:strength].downcase.tr("_", " ") %></span> <%= link_to "seq #{inf[:created_seq]}", contribution_path(inf[:contribution_id]) %></p>
          <% if inf[:rule].present? %><p class="meta">Rule: <%= inf[:rule] %></p><% end %>
          <ul>
            <% inf[:premises].each do |pr| %>
              <li><%= pr[:polarity] == "HOLDS" ? "holds" : "fails" %>: <%= link_to pr[:text], claim_path(pr[:claim_id]) %> <span class="muted">(<%= pr[:state].to_s.downcase.tr("_", " ") %>)</span><% if pr[:weakest] %> <span class="badge">weakest premise</span><% end %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>
  <% end %>
  <p class="meta"><%= @inferences[:note] %></p>

  <%# Threads (Stage 37): what someone has said about how this was recorded. Not
      about whether the claim is true — that is what the evidence above is for —
      and never an input to the number. %>
  <% threads = DeterminationThread.where(subject_type: "Claim", subject_id: @claim.id).newest_first.to_a %>
  <h2 id="threads">Threads</h2>
  <% if threads.any? %>
    <ul class="triage-list">
      <% threads.each do |t| %>
        <li class="<%= "closed" unless t.open? %>">
          <% key, mark, word, full = t.state_badge %>
          <span class="state state-<%= key %>" title="<%= full %>"><span aria-hidden="true"><%= mark %></span> <%= word %></span>
          <%= link_to truncate(t.concern.to_s.squish, length: 110), thread_path(t) %>
        </li>
      <% end %>
    </ul>
    <p class="meta">A thread is about how this was recorded, not about whether it is true. Settling one opens work or closes work and moves no probability.</p>
  <% else %>
    <p class="muted">None. <%= link_to "Threads", threads_path %> are for disagreements about how a determination was made — a statement whose figures are not in the passage it rests on, two sources that may share an origin. Something about the world belongs in the evidence above.</p>
  <% end %>
  <% if authenticated? %>
    <div class="card">
      <%= form_with url: threads_path, method: :post, class: "triage-form" do |f| %>
        <%= f.hidden_field :subject_type, value: "Claim" %>
        <%= f.hidden_field :subject_id, value: @claim.id %>
        <%= f.label :concern, "Raise how this was recorded", class: "meta" %>
        <%= f.text_area :concern, rows: 3, placeholder: "What is wrong with how this was made, and how you know. Not whether the claim is true: record evidence for that." %>
        <p class="triage-actions"><%= f.submit "Open a thread", class: "secondary small" %></p>
      <% end %>
    </div>
  <% end %>

  <h2>Claim edges</h2>
  <% edges = @claim.outgoing_edges.counted_at(@seq).to_a + @claim.incoming_edges.counted_at(@seq).to_a %>
  <% if edges.any? %>
    <table><tr><th>From</th><th>Relationship</th><th>To</th></tr>
    <% edges.each do |e| %><tr><td><%= link_to short_id(e.from_claim_id), claim_path(e.from_claim_id) %></td><td><%= e.relationship_type %></td><td><%= link_to short_id(e.to_claim_id), claim_path(e.to_claim_id) %></td></tr><% end %></table>
  <% else %><p class="muted">None. Edges are stored and displayed; v0.1 does not propagate probability across them.</p><% end %>

  <% if @result %>
    <h2>Review checklist</h2>
    <p><%= review_checks_text(@result.review_checklist) %></p>
    <% if @self_checks.present? %>
      <%# Stage 34: a first pass by one person is worth recording and worth
          labelling. It never counts toward the checklist above. %>
      <p class="meta"><strong><%= pluralize(@self_checks.values.sum, "check") %> by this claim's own author</strong><%= @result.review_checklist.any? { |_, v| v["ok"] } ? ", alongside the independent review above." : ". No independent review yet." %>
      <%= @self_checks.map { |name, n| "#{n} #{name.tr('_', ' ')}" }.join(" · ") %>. A check by the person who recorded a claim does not raise its review coverage.</p>
    <% end %>
    <table><tr><th>Check</th><th>Done</th><th>By</th></tr>
    <% @result.review_checklist.each do |name, v| %><tr><td><%= name.tr("_", " ") %></td><td><%= v["ok"] ? "yes" : "no" %></td><td><%= v["by"].map { |b| short_id(b) }.join(", ") %></td></tr><% end %></table>

    <h2>Summary</h2>
    <div class="card">
      <% @summary[:sentences].each do |s| %><p><%= s["text"] %> <% s["cites"].each do |c| %><span class="badge"><%= c.to_s.start_with?("coverage:", "audit:") ? c : short_id(c) %></span><% end %></p><% end %>
      <p class="meta">Generated by <%= @summary[:generator] %>; every sentence cites graph ids.</p>
    </div>
  <% end %>

  <h2>Contribution history</h2>
  <table><tr><th>seq</th><th>event</th><th>detail</th></tr>
  <% @history.each do |e| %><tr><td><%= e[:seq] %></td><td><%= e[:event] %></td><td><%= [ e[:result], e[:basis], e[:reason] ].compact.join(" · ") %></td></tr><% end %>
  <% @link_contributions.each do |c| %><tr><td><%= c.seq %></td><td><%= c.action_type %></td><td><%= link_to "by #{short_id(c.signer_key_id)} (#{c.current_status.downcase})", contribution_path(c) %></td></tr><% end %>
  </table>

  <% if @result && @show_calculation %>
    <h2>Score trace</h2>
    <pre id="trace"><%= JSON.pretty_generate(@result.trace) %></pre>
  <% end %>
  <% if authenticated? %>
    <details><summary>File under a section</summary>
      <%= form_with url: place_claim_path(@claim), method: :post, class: "filters" do |f| %>
        <label>Section id <%= f.text_field :section_id, placeholder: "from an outline page" %></label>
        <%= f.submit "File", class: "secondary" %>
      <% end %>
    </details>
  <% end %>
  </div>
  </div>
<% end %>

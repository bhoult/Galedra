<% content_for :title, "Share card" %>
<% content_for :head do %>
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="Galedra">
  <meta property="og:title" content="<%= @plain[:headline] %>">
  <meta property="og:description" content="<%= [ "“#{@claim.canonical_text}”", @plain[:say_instead] && "Say instead: #{@plain[:say_instead]}", "Checked in Galedra, an epistemic ledger. Provisional until audited." ].compact.join(" ") %>">
  <meta property="og:url" content="<%= card_claim_url(@claim) %>">
  <meta property="og:image" content="<%= card_claim_url(@claim, format: :png) %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= @plain[:headline] %>">
  <meta name="twitter:image" content="<%= card_claim_url(@claim, format: :png) %>">
<% end %>
<div class="share">
  <p class="eyebrow">Checked, not settled</p>
  <div class="card">
    <p class="headline"><%= @plain[:headline] %></p>
    <p class="claim-text">“<%= @claim.canonical_text %>”</p>
    <% if @plain[:say_instead] %><p class="say-instead"><strong>Say instead:</strong> <%= @plain[:say_instead] %></p><% end %>
    <p class="meta"><%= @card[:headline] %><% if @card[:stated] %> · <%= @card[:stated] %><% end %> · review checks <%= @card[:review_checks] %> · provisional until audited. The number is model-conditional, not a share of truth.</p>
  </div>
  <%# The link is what gets shared, so it is the thing to copy (2026-09-23). %>
  <p class="meta">Link to share: <code data-copy><%= card_claim_url(@claim) %></code></p>
  <p><%= link_to "See the evidence", claim_path(@claim) %> · <%= image_tag card_claim_path(@claim, format: :png), alt: "", class: "share-preview", width: 600, height: 315 %></p>
</div>

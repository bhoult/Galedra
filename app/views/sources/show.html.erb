<% content_for :title, "Source" %>
<h1>Source</h1>
<% if @quarantine %>
  <div class="card"><p class="headline">Quarantined</p><p>Content withheld. Quarantined at seq <%= @quarantine.created_seq %> by <code><%= @quarantine.contribution.signer_key_id %></code>, reason <strong><%= @quarantine.reason %></strong>. <%= link_to "Moderation log", moderation_path %></p></div>
<% else %>
  <div class="card">
    <p><strong><%= @source.title || "[redacted]" %></strong> <span class="badge"><%= @source.source_type %></span><% if @source.retrieval_pending %> <span class="badge">retrieval pending</span><% end %></p>
    <p class="meta"><%= [ @source.creator, @source.publisher, @source.publication_date ].compact.join(" · ") %> · <% if @source.content_hash %>content hash <code><%= @source.content_hash %></code><% else %>no page hash: the reader saw a rendering, not the bytes<% end %> · <%= link_to "created seq #{@source.created_seq}", contribution_path(@source.contribution_id) %></p>
    <% if @source.canonical_uri.present? %><p class="meta">Link: <%= safe_source_link(@source.canonical_uri) %><% if @source.retrieved_at %> · read at <%= @source.retrieved_at.utc.iso8601 %><% end %><% if @source.by_reference? %> · held by reference: only the link, the quoted excerpts with their hashes, and the page hash when the reader had the bytes are stored<% end %></p><% end %>
    <% if @source.content %><details><summary>Stored text (<%= @source.content_length %> characters)</summary><pre><%= @source.content %></pre></details><% end %>
  </div>

  <% roots = Section.counted_at(@seq).where(source_id: @source.id, parent_id: nil).order(:created_seq) %>
  <% if roots.any? || authenticated? %>
    <h2>Outlines of this source</h2>
    <% if roots.any? %><ul><% roots.each do |r| %><li><%= link_to r.heading, section_path(r) %></li><% end %></ul><% else %><p class="muted">None yet.</p><% end %>
    <% if authenticated? %>
      <details><summary>Add an outline</summary>
        <%= form_with url: sections_path, method: :post do |f| %>
          <%= f.hidden_field :source_id, value: @source.id %>
          <p><%= f.label :outline, "Headings, one per line, indented two spaces per level" %><br><%= f.text_area :outline, rows: 8, placeholder: "Episode 123\n  LLM alignment\n    OpenAI\n    Anthropic\n  Math is cooked" %></p>
          <p><%= f.submit "Record the outline", class: "secondary" %></p>
        <% end %>
      </details>
    <% end %>
  <% end %>
  <% retrievals = SourceRetrieval.where(source_id: @source.id).latest_first.to_a %>
  <% if retrievals.any? || @source.retrieval_pending %>
    <h2>Retrieval by Galedra</h2>
    <% if retrievals.empty? %><p class="muted">Not yet fetched. Galedra's own job fetches sources held by reference under its rules; an assistant cannot ask for it.</p><% end %>
    <% retrievals.each do |r| %>
      <div class="card">
        <p><strong><%= r.outcome %></strong> at <%= r.fetched_at.utc.iso8601 %><% if r.final_url.present? %> · <%= safe_source_link(r.final_url) %><% end %> · <%= link_to "seq #{r.created_seq}", contribution_path(r.contribution_id) %></p>
        <% if r.fetched? %><p class="meta">Server hash <code><%= r.content_hash %></code> · <%= r.content_length %> bytes · <%= r.media_type %><% if @source.content_hash && @source.content_hash != r.content_hash %> · differs from the reader's hash<% elsif @source.content_hash %> · matches the reader's hash<% end %>. The reader's record is unchanged; this is the server's finding beside it.</p><% end %>
        <% if r.excerpts.any? %>
          <%# The word and what it means, because one word carried two facts: a
              passage genuinely absent and a document this server never read. %>
          <table><tr><th>Excerpt</th><th>Finding</th></tr>
          <% r.excerpts.each do |e| %><% loc = SourceLocation.find_by(id: e["location_id"]) %><tr><td><%= truncate(loc&.excerpt.to_s, length: 160) %></td><td><strong><%= e["found"].to_s.downcase.tr("_", " ") %></strong> — <%= SourceRetrieval.means(e["found"]) %></td></tr><% end %></table>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if @cards %>
    <h2>Claims from this source</h2>
    <p><%= @cards[:summary] %></p>
    <% if @cards[:state_counts].any? %>
      <p class="meta">Counts by assessment state (descriptive only; counts depend on extraction granularity, and there is never a score for the source or its author):
        <% @cards[:state_counts].each do |state, n| %><span class="badge"><%= n %> <%= state_label(state) %></span><% end %></p>
    <% end %>
    <% @cards[:cards].each do |c| %>
      <% if c[:quarantined] %><div class="card"><p class="headline">Quarantined</p></div>
      <% else %>
        <p><%= link_to c[:text], claim_path(c[:claim_id]) %> <span class="badge"><%= c[:type] %></span></p>
        <%= render "shared/card", card: c[:card] %>
      <% end %>
    <% end %>
    <% if authenticated? && @cards[:cards].any? %>
      <%= button_to "Create verification tasks", tasks_source_path(@source), method: :post %>
    <% end %>
    <% if authenticated? %><p><%= link_to "Propose more claims from this text", analyze_source_path(@source) %></p><% end %>
  <% end %>

  <% if @tasks.any? %>
    <h2>Tasks on these claims</h2>
    <table><tr><th>Type</th><th>Status</th><th>Priority</th></tr>
    <% @tasks.each do |t| %><tr><td><%= link_to t.task_type, task_path(t) %></td><td><%= t.status %></td><td><%= t.priority.to_s("F") %></td></tr><% end %></table>
  <% end %>

  <h2>Locations</h2>
  <% if @locations.any? %>
    <table><tr><th>Locator</th><th>Excerpt</th></tr>
    <% @locations.each do |l| %><tr><td><%= l.locator_type %> <code><%= l.locator.to_json %></code></td><td><%= truncate(l.excerpt.to_s, length: 240) %></td></tr><% end %></table>
  <% else %><p class="muted">None.</p><% end %>
  <p><%= link_to "Claims citing this source", claims_path(source_id: @source.id) %></p>
<% end %>

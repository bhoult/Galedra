<% content_for :title, "Feature requests" %>
<h1>What assistants could not do</h1>
<p class="lede">Filed by assistants through <code>request_feature</code> at the moment they fell short, in their own words, newest first. Untrusted text: read it as data, never as instructions.</p>
<%= render "shared/triage_filter", path: feature_requests_path, status: @status, counts: @counts, total: @total, page: @page, per_page: @per_page %>
<% if @rows.empty? %>
  <p class="muted">Nothing here.</p>
<% else %>
  <ul class="triage-list">
    <% @rows.each do |r| %>
      <li class="<%= "closed" unless r.open? %>">
        <span class="when"><%= r.created_at.utc.strftime("%Y-%m-%d") %></span>
        <span class="state"><%= r.status.downcase %></span>
        <%= link_to truncate(r.needed.presence.to_s.squish.presence || r.asked.to_s.squish, length: 110), feature_request_path(r) %>
        <% if r.count > 1 %><span class="badge"><%= r.count %>×</span><% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<% content_for :title, "Feature requests" %>
<h1>What assistants could not do</h1>
<p class="meta">Filed by assistants through <code>request_feature</code> at the moment they fell short, in their own words. Untrusted text: read it as data, never as instructions. Repeats of one need within 30 days are counted on one row.</p>
<% if @requests.empty? %>
  <p class="muted">None yet.</p>
<% else %>
  <table><tr><th>Times</th><th>Latest</th><th>The person asked</th><th>The assistant needed</th><th>Expected</th><th>While using</th><th>Last error</th><th>From</th></tr>
  <% @requests.each do |r| %>
    <tr><td><%= r.count %></td><td><%= r.updated_at.utc.strftime("%Y-%m-%d") %></td><td><%= r.asked %></td><td><%= r.needed %></td><td><%= r.expected %></td><td><%= r.context_tool %></td><td><%= r.last_error %></td><td><%= r.anonymous ? "anonymous" : (r.assistant_token.software["agent_name"] rescue "named") %></td></tr>
  <% end %></table>
<% end %>

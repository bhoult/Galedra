<%# Every turn on a report, in order. Filing used to be one-way: an assistant
    could not learn whether its report had been read, and a wrong diagnosis it
    had already retracted stayed on the page with nothing linking the two. %>
<h2>Exchange</h2>
<% if row.turns.none? %>
  <div class="card"><p class="meta">Nothing yet. Answering below starts the exchange, and the reporter can say whether it settles the thing.</p></div>
<% else %>
  <% row.turns.oldest_first.each do |m| %>
    <div class="card">
      <p class="meta">
        <strong><%= m.from_assistant? ? "Reporter" : "Maintainer" %></strong> ·
        <%= m.created_at.utc.strftime("%Y-%m-%d %H:%M") %> UTC
        <% unless m.satisfied.nil? %>
          · <strong><%= m.satisfied ? "satisfied" : "not satisfied" %></strong>
        <% end %>
      </p>
      <%= simple_format(m.body) %>
    </div>
  <% end %>
<% end %>
<p class="meta">
  <strong><%= row.state_line %></strong>
  <% if row.awaiting_reporter? && row.settles_at %>
    · nothing said by <%= row.settles_at.utc.strftime("%Y-%m-%d %H:%M") %> UTC and it closes on its own; they can still disagree afterwards and it reopens.
  <% elsif row.status == "CLOSED" && !row.agreed? %>
    · the reporter never answered, so this settled on its own. It reopens if they disagree later.
  <% end %>
</p>

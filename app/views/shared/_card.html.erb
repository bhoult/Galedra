<%# The answer card (spec 06 §3, §4). The number is never the headline; since
    2026-09-23 (owner decision) it sits under it, with model and snapshot, when
    the claim has one. INSUFFICIENT_EVIDENCE and NOT_APPLICABLE have none. %>
<div class="card">
  <p class="headline"><%= card[:headline] %></p>
  <% if card[:stated] %><p class="meta score-line" title="Model-conditional, not a share of truth. The trace is under Show calculation.">Score: <%= card[:stated] %></p><% end %>
  <p class="meta">
    <%= pluralize(card[:independent_lineages], "independent evidence lineage") %> ·
    review checks <%= card[:review_checks] %> ·
    stability <%= card[:stability] || "n/a" %>
  </p>
  <% if card[:reason] %><p><%= card[:reason] %></p><% end %>
  <p><strong>Main unresolved issue:</strong> <%= card[:main_issue][:text] %>
    <% card[:main_issue][:cites].each do |c| %><span class="badge"><%= c.to_s.start_with?("coverage:", "audit:") ? c : short_id(c) %></span><% end %></p>
  <% if card[:labels].any? %><p class="labels"><% card[:labels].each do |l| %><span><%= l %></span><% end %></p><% end %>
  <% if card[:related].any? %>
    <p class="meta">Related: <% card[:related].each do |r| %><%= link_to "#{r[:relation]} #{r[:direction]}: #{r[:headline]}", claim_path(r[:claim_id], model: card[:model], snapshot_seq: card[:snapshot_seq]) %> <% end %></p>
  <% end %>
</div>

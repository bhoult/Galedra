<%# Status filter, counts and paging for the two maintainer lists. `path` is the
    index route, `counts` a {status => n} hash, `total` the size of the filtered
    set. %>
<p class="meta triage-filter">
  <% [ [ nil, "All" ] ] .concat(Triageable::STATUSES.map { |s| [ s, s.capitalize ] }).each do |value, label| %>
    <% n = value.nil? ? counts.values.sum : counts.fetch(value, 0) %>
    <% if status == value %>
      <strong><%= label %> (<%= n %>)</strong>
    <% else %>
      <%= link_to "#{label} (#{n})", url_for(status: value, page: nil) %>
    <% end %>
    <%= " · " unless value == Triageable::STATUSES.last %>
  <% end %>
</p>
<% pages = (total / per_page.to_f).ceil %>
<% if pages > 1 %>
  <p class="meta">
    Page <%= page %> of <%= pages %> · <%= pluralize(total, "entry") %>
    <% if page > 1 %> · <%= link_to "Newer", url_for(page: page - 1) %><% end %>
    <% if page < pages %> · <%= link_to "Older", url_for(page: page + 1) %><% end %>
  </p>
<% end %>

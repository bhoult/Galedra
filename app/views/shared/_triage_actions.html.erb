<%# A reply is a turn in the exchange, so the box starts empty: what was said
    before is in the thread above, and pre-filling it would repost it. %>
<h2>Your reply</h2>
<div class="card">
  <%= form_with url: url_for(controller: controller_name, action: :update, id: row.id), method: :patch, class: "triage-form" do |f| %>
    <%= f.label :resolution, row.awaiting_reporter? ? "Add to your answer" : "What you want to say to whoever filed this", class: "meta" %>
    <%= f.text_area :resolution, value: nil, rows: 4,
                    placeholder: "What was done, or why this needs nothing. It goes on this page as your turn, and the reporter is asked whether it settles the thing." %>
    <%# Stage 42 §9: so the filer can check the fix without the repository. %>
    <%= f.label :fixed_in, "Fixed in (a commit or tag already pushed)", class: "meta" %>
    <%= f.text_field :fixed_in, value: nil, maxlength: 100, placeholder: "e.g. 288125a" %>
    <%= f.label :repro, "The call to re-run, and what it should now return", class: "meta" %>
    <%= f.text_area :repro, value: nil, rows: 2, placeholder: "e.g. submit_task with links[0].steps as [\"one\"] now answers SCHEMA_INVALID naming answer.links[0].steps" %>
    <p class="triage-actions">
      <%= f.submit "Answer", name: "status", value: "ANSWERED", class: "primary small" %>
      <%= f.submit "Answer and hold", name: "status", value: "HELD", class: "secondary small" %>
      <% if row.status != "OPEN" %>
        <%= f.submit "Reopen", name: "status", value: "OPEN", class: "secondary small" %>
      <% end %>
      <% if row.status != "IGNORED" %>
        <%= f.submit "Ignore", name: "status", value: "IGNORED", class: "secondary small" %>
      <% end %>
      <% if row.status != "CLOSED" %>
        <%= f.submit "Close it yourself", name: "status", value: "CLOSED", class: "secondary small" %>
      <% end %>
    </p>
    <p class="meta">
      <strong>Answer</strong> replies and hands it back: the reporter says whether it settles the thing, and only then does it close.
      <strong>Answer and hold</strong> replies the same way but stops the <%= Triageable::UNANSWERED_AFTER.inspect %> timeout closing it,
      for when you have agreed to work that is not done yet and silence would settle nothing.
      <strong>Close it yourself</strong> skips the reporter's turn, which is what a report from a visitor with nobody to ask needs.
    </p>
  <% end %>
</div>

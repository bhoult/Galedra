<%# Status and reason together: the box is filled in at the moment the decision
    is made, because a closed list with no reasons tells the next reader nothing
    about whether a thing was fixed, was working as intended, or was set aside.
    Leaving it empty keeps whatever reason was given before. %>
<%= form_with url: url_for(controller: controller_name, action: :update, id: row.id), method: :patch, class: "triage-form" do |f| %>
  <%= f.label :resolution, "Why", class: "meta" %>
  <%= f.text_area :resolution, value: row.resolution, rows: 3,
                  placeholder: "What was done, or why this needs nothing. Shown on this page from now on." %>
  <p class="triage-actions">
    <% Triageable::STATUSES.each do |target| %>
      <% next if target == row.status %>
      <%# "Answer" rather than "Done": a maintainer's reply hands the report back
          to whoever filed it, and only their verdict reaches Closed. %>
      <%= f.submit({ "OPEN" => "Reopen", "ANSWERED" => "Answer", "CLOSED" => "Close", "IGNORED" => "Ignore" }.fetch(target, target.capitalize),
                   name: "status", value: target,
                   class: target == "ANSWERED" ? "primary small" : "secondary small") %>
    <% end %>
    <%= f.submit "Save reason", name: "status", value: row.status, class: "secondary small" %>
  </p>
<% end %>

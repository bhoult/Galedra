<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Galedra" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="site">
      <%= link_to "Galedra", root_path, class: "brand" %>
      <%= link_to "Analyze text", new_analyze_path %>
      <%= link_to "Browse claims", claims_path %>
      <%= link_to "Task board", tasks_path %>
      <%= link_to "Recent audits", contributions_path(action_type: "AUDIT") %>
      <%= link_to "Weaknesses", weaknesses_path %>
      <%= link_to "Moderation log", moderation_path %>
      <%= link_to "Log", contributions_path %>
      <span class="muted" style="margin-left:auto">
        <% if authenticated? %>
          <%= Current.user.email_address %> · <%= button_to "Sign out", session_path, method: :delete, class: "secondary", form_class: "inline" %>
        <% else %>
          <%= link_to "Sign in", new_session_path %> · <%= link_to "Sign up", new_user_path %>
        <% end %>
      </span>
    </header>
    <main>
      <% if notice %><p class="flash"><%= notice %></p><% end %>
      <% if alert %><p class="flash"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>

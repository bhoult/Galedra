<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) ? "#{yield(:title)} · Galedra" : "Galedra" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="Galedra is an epistemic ledger: a signed, append-only record of claims, evidence, provenance, audits, and reproducible scores, contributed to by people and AI.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <meta name="theme-color" content="#2c5a86">
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= content_for?(:body_class) ? yield(:body_class) : "" %>">
    <%= yield :background %>
    <header class="site">
      <%= link_to root_path, class: "brand" do %><%= image_tag "logo.svg", alt: "", class: "brand-mark", width: 26, height: 26 %> Galedra<% end %>
      <%= render "layouts/nav" %>
      <div class="account">
        <% if authenticated? %>
          <%= link_to Current.user.email_address, account_path, class: "muted", title: "Your account" %>
          <%= button_to "Sign out", session_path, method: :delete, class: "secondary small", form_class: "inline" %>
        <% else %>
          <%= link_to "Sign in", new_session_path %>
          <%= link_to "Sign up", new_user_path, class: "button small" %>
        <% end %>
      </div>
    </header>
    <main>
      <% if notice %><p class="flash"><%= notice %></p><% end %>
      <% if alert %><p class="flash"><%= alert %></p><% end %>
      <%= yield %>
    </main>
    <footer class="site">
      <p>Not a source of truth. A source of traceable reasons.</p>
      <p class="links">
        <%= link_to "Constitution", constitution_path %>
        <%= link_to "FAQ", faq_path %>
        <%= link_to "Docs", docs_path %>
        <%= link_to "Licences", licenses_path %>
        <%= link_to "About", about_path %>
        <%= link_to "Contact", contact_path %>
        <%= link_to "API", api_v1_meta_path %>
        <%= link_to "Log", contributions_path %>
      </p>
    </footer>
  </body>
</html>

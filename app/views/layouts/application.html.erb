<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) ? "#{yield(:title)} · Galedra" : "Galedra" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="Galedra is an epistemic ledger: a signed, append-only record of claims, evidence, provenance, audits, and reproducible scores, contributed to by people and AI.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <meta name="theme-color" content="#2c5a86">
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= content_for?(:body_class) ? yield(:body_class) : "" %>">
    <%= yield :background %>
    <header class="site">
      <%= link_to root_path, class: "brand" do %><%= image_tag "logo.svg", alt: "", class: "brand-mark", width: 26, height: 26 %> Galedra<% end %>
      <nav aria-label="Primary">
        <% if authenticated? %>
          <%= link_to "Analyze text", new_analyze_path %>
          <%= link_to "Claims", claims_path %>
          <%= link_to "Tasks", tasks_path %>
          <%= link_to "Audits", contributions_path(action_type: "AUDIT") %>
          <%= link_to "Weaknesses", weaknesses_path %>
          <%= link_to "Moderation", moderation_path %>
          <%= link_to "Log", contributions_path %>
          <%= link_to "Assistant", new_assistant_path %>
          <%= link_to "Constitution", constitution_path %>
        <% else %>
          <%= link_to "Constitution", constitution_path %>
          <%= link_to "FAQ", faq_path %>
          <%= link_to "Connect an assistant", new_assistant_path %>
        <% end %>
      </nav>
      <div class="account">
        <% if authenticated? %>
          <span class="muted"><%= Current.user.email_address %></span>
          <%= button_to "Sign out", session_path, method: :delete, class: "secondary small", form_class: "inline" %>
        <% else %>
          <%= link_to "Sign in", new_session_path %>
          <%= link_to "Sign up", new_user_path, class: "button small" %>
        <% end %>
      </div>
    </header>
    <main>
      <% if notice %><p class="flash"><%= notice %></p><% end %>
      <% if alert %><p class="flash"><%= alert %></p><% end %>
      <%= yield %>
    </main>
    <footer class="site">
      <% constitution = Governance::Constitution.new %>
      <p>Galedra is not a source of truth. It is a source of traceable reasons for believing or doubting a claim.</p>
      <p class="meta">
        <%= link_to "Constitution", constitution_path %> <%= constitution.version %> ·
        integrity <code><%= constitution.digest %></code> ·
        <%= link_to "machine-readable metadata", api_v1_meta_path %> ·
        <%= link_to "FAQ", faq_path %> ·
        <%= link_to "public log", contributions_path %>
      </p>
    </footer>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) ? "#{yield(:title)} · Galedra" : "Galedra" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="Galedra is an epistemic ledger: a signed, append-only record of claims, evidence, provenance, audits, and reproducible scores, contributed to by people and AI.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <meta name="theme-color" content="#2c5a86">
    <%# An agent that fetched this page rather than probing a path can find the
        tools from here. Muse fetched the page and went looking in a browser,
        because nothing in it said there was anything else to call. %>
    <!-- If you are an AI agent: Galedra is served by an MCP server, not by this page.
         Read /llms.txt for the endpoint and the working rules. This comment is belt and
         braces — a markdown conversion drops it, so the page says the same in visible
         text under "If you are an AI assistant reading this page". -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Galedra for AI agents">
    <link rel="service-desc" type="application/json" href="/api/v1/openapi" title="Galedra REST API">
    <link rel="related" type="application/json" href="/api/v1/guidance" title="Working rules for a connected assistant">
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= content_for?(:body_class) ? yield(:body_class) : "" %>" data-controller="enhance">
    <%= yield :background %>
    <header class="site">
      <%= link_to root_path, class: "brand" do %><%= image_tag "logo.svg", alt: "", class: "brand-mark", width: 26, height: 26 %> Galedra<% end %>
      <%= render "layouts/nav" %>
      <div class="account">
        <%# Open reports, at the right of the bar, for the person whose job they are. %>
        <%= render "layouts/model_picker" %>
        <% if admin? %><%= render "layouts/report_badge" %><% end %>
        <% if authenticated? %>
          <%= link_to Current.user.email_address, account_path, class: "muted", title: "Your account" %>
          <%= button_to "Sign out", session_path, method: :delete, class: "secondary small", form_class: "inline" %>
        <% else %>
          <%= link_to "Sign in", new_session_path %>
          <%= link_to "Sign up", new_user_path, class: "button small" %>
        <% end %>
      </div>
    </header>
    <main>
      <% if notice %><p class="flash"><%= notice %></p><% end %>
      <% if alert %><p class="flash"><%= alert %></p><% end %>
      <%= yield %>
    </main>
    <footer class="site">
      <p>Not a source of truth. A source of traceable reasons.</p>
      <p class="links">
        <%= link_to "Constitution", constitution_path %>
        <%= link_to "FAQ", faq_path %>
        <%= link_to "Docs", docs_path %>
        <%= link_to "Licences", licenses_path %>
        <%= link_to "About", about_path %>
        <%= link_to "Contact", contact_path %>
        <%= link_to "Terms", terms_path %>
        <%= link_to "Privacy", privacy_path %>
        <%= link_to "Takedown", takedown_path %>
        <%= link_to "Meta", api_v1_meta_path %>
        <%= link_to "Log", contributions_path %>
      </p>
    </footer>
  </body>
</html>

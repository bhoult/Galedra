<%# Nothing at all when nothing is held: a permanent 0 would be a number nobody
    can act on sitting next to one they can. An open palm, because held means
    stop rather than wait — nothing will close this until the work is done. %>
<% if n.to_i.positive? %>
  <% tip = "#{pluralize(n, kind)} answered and held open: work has been agreed and not done, so silence will not close it" %>
  <%= link_to path, class: "held", title: tip, data: { tip: tip } do %><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 11V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2"/><path d="M14 10V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v2"/><path d="M10 10.5V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/></svg><%= n %><% end %>
<% end %>

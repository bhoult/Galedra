<%# Primary navigation (Stage 24): drop-down menus built on details/summary so they work without JavaScript; menu_controller closes the others. Admin appears only to admins. %>
<nav aria-label="Primary" data-controller="menu tooltip">
  <details class="menu" data-menu-target="item">
    <summary>Check</summary>
    <div class="menu-panel">
      <%= nav_link "Record a check", new_investigation_path, "A check reads a statement against real sources and records what they say, passage by passage." %>
      <% if authenticated? %><%= nav_link "Analyze text", new_analyze_path %><% end %>
    </div>
  </details>
  <details class="menu" data-menu-target="item">
    <summary>Browse</summary>
    <div class="menu-panel">
      <%= nav_link "Topics", topics_path, "A topic is a subject from a fixed vocabulary, attached to claims so related ones can be found together." %>
      <%= nav_link "Investigations", investigations_path, "An investigation is one recorded check: a whole statement, the claims it was broken into, and what the sources said about each." %>
      <%= nav_link "Outlines", sections_path, "An outline is a long source broken into sections, so a speech or transcript can be checked a part at a time." %>
      <%= nav_link "Claims", claims_path, "A claim is one checkable assertion, stated narrowly enough that evidence can bear on it." %>
      <%= nav_link "Contributors", contributors_path, "A contributor is a signing key, a person or an assistant, credited for the work it signed." %>
      <%= nav_link "Tasks", tasks_path, "A task is a unit of open work with a signed packet of just enough context to do it." %>
      <%= nav_link "Threads", threads_path, "A thread is a disagreement about how a determination was made — not about whether a claim is true, which evidence settles, and not about Galedra, which the bug reports cover." %>
      <%= nav_link "Weaknesses", weaknesses_path, "Weaknesses are where this record is most likely wrong, worked out by rule rather than by anyone's judgement." %>
      <%= nav_link "Audits", contributions_path(action_type: "AUDIT"), "An audit is an independent check of an earlier contribution: was the passage really there, was the reading fair." %>
      <%= nav_link "Log", contributions_path, "The log is the signed, append-only record every page here is derived from. Nothing is edited; corrections are new entries." %>
      <%= nav_link "Moderation log", moderation_path, "Quarantine hides a record pending review; a takedown removes content and leaves a visible stub. Both appear here." %>
    </div>
  </details>
  <% if admin? %>
    <details class="menu" data-menu-target="item">
      <summary>Admin</summary>
      <div class="menu-panel">
        <%= nav_link "Users", admin_users_path %>
        <%= nav_link "Affiliation requests", admin_affiliation_requests_path, "An affiliation is a group a person declares themselves part of. These are new ones waiting to be merged or added." %>
        <%= nav_link "Content review", admin_content_reviews_path, "Submitted text an agent flagged as possibly offensive, and the consensus that settled it." %>
        <%= nav_link "Feature requests", feature_requests_path %>
        <%= nav_link "Bug reports", bug_reports_path %>
      </div>
    </details>
  <% elsif moderator? %>
    <details class="menu" data-menu-target="item">
      <summary>Moderate</summary>
      <div class="menu-panel">
        <%= nav_link "Feature requests", feature_requests_path %>
        <%= nav_link "Bug reports", bug_reports_path %>
      </div>
    </details>
  <% end %>
  <details class="menu" data-menu-target="item">
    <summary>Help</summary>
    <div class="menu-panel">
      <%= nav_link "FAQ", faq_path %>
      <%= nav_link "Glossary", glossary_path %>
      <%= nav_link "How a score is worked out", scoring_path, "Every factor in a score, what it means and why it is there, with the numbers read from the released model." %>
      <%= nav_link "How to connect an assistant", connect_path, "The address, the three ways a client may ask for a credential, and the words to paste into a connector directory." %>
      <%= nav_link "Mint an assistant token", new_assistant_path, "A connected assistant holds a token and signs contributions for you, under your name or anonymously." %>
      <%# Signed in, the home page is the dashboard, so the signed-out page —
          what Galedra is for, and the notice addressed to an agent that fetched
          it — is unreachable without signing out (owner, 2026-09-22). %>
      <%= nav_link "What Galedra is", root_path(intro: 1), "The introduction the signed-out home page shows: what this is for, and the notice an AI assistant reads if it was handed the address." %>
      <%= nav_link "Docs", docs_path %>
      <%= nav_link "API reference", api_docs_path %>
      <%= nav_link "Constitution", constitution_path, "The twenty-five articles the project is bound by. They outrank the specification and the code." %>
      <%= nav_link "Licences", licenses_path %>
      <%= nav_link "About", about_path %>
      <%= nav_link "Contact", contact_path %>
      <%= nav_link "Report a bug", new_bug_report_path %>
    </div>
  </details>
</nav>

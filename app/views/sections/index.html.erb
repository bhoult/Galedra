<% content_for :title, "Outlines" %>
<h1>Outlines</h1>
<p class="meta">Long sources (a transcript, a speech, a long article) read as a tree of sections with the claims filed under each. <%= Sections::Tree::NOTE %> To help with one, tell your assistant: <code>work the open tasks in Galedra on</code> its address.</p>
<%= form_with url: sections_path, method: :get, class: "filters" do |f| %>
  <label>Order <%= f.select :sort, [ [ "most open work first", "" ], [ "newest", "newest" ] ], { selected: params[:sort] } %></label>
  <label>Topic <%= f.select :topic, [ [ "any", "" ] ] + Topics.index.values.map { |n| [ n.top? ? n.label : "#{n.parent.label} / #{n.label}", n.path ] }, { selected: params[:topic] } %></label>
  <%= f.submit "Show", class: "secondary" %>
<% end %>
<% if @rows.empty? %><p class="muted">None yet. Add one from a source page, or ask your assistant to record a large source with an outline.</p><% else %>
<table><tr><th>Outline</th><th>Source</th><th>Progress</th><th>Open work</th><th>Counts by state</th></tr>
<% @rows.each do |root, tree, p| %>
  <tr><td><%= link_to root.heading, section_path(root) %></td><td><%= link_to root.source.title, source_path(root.source) %></td>
    <td><%= p[:leaves_extracted] %> of <%= p[:leaves] %> leaves extracted · <%= p[:checked] %> of <%= p[:claims] %> claims with evidence<%= " · #{tree[:pending]} proposed" if tree[:pending].positive? %></td>
    <td><%= p[:open_tasks] %></td><td class="meta"><%= Sections::Tree.states_line(tree[:counts]) %></td></tr>
<% end %></table>
<% end %>

<% content_for :title, @section.heading %>
<% content_for :head do %>
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="Galedra">
  <meta property="og:title" content="<%= @section.root.heading %>">
  <meta property="og:description" content="<%= "#{Cards::ShareText.summary_line(@share_line)}. #{pluralize(@progress[:claims], 'claim')} from this source, each checked against other sources in Galedra, a public record of claims and the evidence for and against them." %>">
  <meta property="og:url" content="<%= section_url(@section) %>">
<% end %>
<% open_ids = ([ @section ] + @ancestors).map(&:id) %>
<div class="with-outline">
  <aside class="outline tree">
    <h2><%= reading_mark(@tree[:verdict], of: "in this outline") %><%= link_to @section.root.heading, section_path(@section.root), data: { turbo_frame: outline_frame } %></h2>
    <%= render "sections/tree", node: @tree, open_ids: open_ids, current_claim: @current_claim, current_section: @section.id, seq: @seq, model: @model %>
  </aside>
  <%# Only this reloads when a section is chosen. The outline beside it stays in
      the page, which is what lets it animate and what stops a menu click from
      fetching a whole document. %>
  <%# target: "_top" so that every link in the pane leaves the outline as an
      ordinary page load unless it names this frame. Without it, the source
      link, a contribution link or a claim link loaded its page *into* the pane,
      found no matching frame there, and Turbo showed "Content missing"
      (owner, 2026-09-23). Section links name the frame and stay in it. %>
  <%= turbo_frame_tag outline_frame, target: "_top", data: { turbo_action: "advance", controller: "reading-pane" } do %>
<p class="meta"><%= link_to "Outlines", sections_path, data: { turbo_frame: "_top" } %><% @ancestors.each do |a| %> › <%= link_to a.heading, section_path(a), data: { turbo_frame: outline_frame } %><% end %> › <%= @section.heading %></p>
<h1><%= reading_mark(@subtree[:verdict], of: (@section.parent_id.nil? ? "in this outline" : "under this section")) %><%= @section.heading %></h1>
<div class="card">
  <p class="meta">Source: <%= link_to @section.source.title, source_path(@section.source) %><% if @section.location %> · <%= locator_label(@section.location) %><% end %> · <%= link_to "created seq #{@section.created_seq}", contribution_path(@section.contribution_id) %></p>
  <% if @section.location&.excerpt.present? %>
    <blockquote class="passage"><%= simple_format(@section.location.excerpt) %></blockquote>
    <p class="meta">The opening words of this section, quoted exactly. This is what is hashed and checked against the source.</p>
  <% end %>
  <% if (figure = @subtree.dig(:verdict, :stated)) %><p class="meta score-line" title="<%= @subtree[:verdict][:note] %>">Score: <strong><%= @subtree[:verdict][:figure] %></strong> · <%= figure %></p><% end %>
  <p><strong><%= Sections::Tree.counts_line(@subtree[:counts]) %></strong><% if @subtree[:pending].positive? %> · <%= @subtree[:pending] %> proposed claims awaiting acceptance<% end %></p>
  <% if @subtree[:children].empty? && @subtree[:claims].empty? %><p class="muted">Nothing under this section yet. Its claims arrive when the extraction task below is worked.</p><% end %>
  <p class="meta"><%= Sections::Tree::NOTE %> As of snapshot <%= @seq %><%= " under #{@model.full_name}" if @model %>.</p>
  <p class="meta">Progress of the whole outline: <%= @progress[:leaves_extracted] %> of <%= @progress[:leaves] %> leaves extracted · <%= @progress[:checked] %> of <%= @progress[:claims] %> claims with evidence · <%= @progress[:open_tasks] %> open tasks.</p>
  <p><strong>Share:</strong></p><p class="share-line" data-copy><%= @share_line %></p>
</div>
<% if @text.any? %>
  <div class="card reading">
    <h2><%= @section.parent_id.nil? ? "The whole text" : "The text" %></h2>
    <p class="meta"><%= Sections::Text::NOTE %> <%= pluralize(Sections::Text.characters(@section, @seq), "character") %> across <%= pluralize(@text.size, "section") %>.</p>
    <% @text.each do |part| %>
      <% if part.section != @section %>
        <h3 class="reading-heading" style="margin-left: <%= [ part.depth - 1, 3 ].min * 0.8 %>rem">
          <%= link_to part.section.heading, section_path(part.section), data: { turbo_frame: outline_frame } %>
        </h3>
      <% end %>
      <div class="reading-body"><%= simple_format(part.text) %></div>
      <p class="meta small">Read by <%= link_to short_id(part.location.contribution_id), contribution_path(part.location.contribution_id), data: { turbo_frame: "_top" } %><% if part.section.location&.excerpt.present? %> · anchored on “<%= truncate(part.section.location.excerpt, length: 70) %>”<% end %></p>
    <% end %>
  </div>
<% end %>
<%# Who initiated this outline: the contributor who recorded its root section,
    not whoever last added a child (owner request, 2026-09-21).

    Outside the Turbo frame on purpose. It is a property of the outline, not of
    the section being read, so it is identical for every section in the tree —
    and inside the frame it re-ran `Section.find_by`, `contributor` and
    `principal_contributor` (which asks for its delegation separately) on every
    click, which is the per-click work the frame exists to avoid (code review,
    2026-09-22). %>
<% root = @section.root_id ? Section.find_by(id: @section.root_id) : @section %>
<% entry = (root || @section).contribution %>
<%= render "shared/attribution", agent: entry&.contributor, principal: entry&.principal_contributor,
           at: entry&.received_at, contribution_id: entry&.id,
           everyone_path: contributors_section_path(@section) %>

<%# One question for the whole set: asking each task for its open slots was two
    COUNTs apiece and 4,380 queries on this page (Stage 39). %>
<% open_tasks = Tasks::Status.open_among(Task.where(section_id: Tasks::Lease.subtree_ids(@section.id), status: %w[OPEN LEASED])) %>
<div class="card">
  <p><strong>Open work under this section: <%= open_tasks.size %></strong><% if open_tasks.any? %> (<%= open_tasks.group_by(&:task_type).map { |k, v| "#{v.size} #{k.downcase.tr('_', ' ')}" }.join(", ") %>)<% end %>.</p>
  <p class="meta">To help, tell your assistant: <code data-copy>work the open tasks in Galedra on <%= section_url(@section) %></code>. Extracted claims are recorded and their verification tasks open at once, so anyone can carry on from where the last person stopped.</p>
</div>
<% if authenticated? %>
  <details><summary>Add sections under this one</summary>
    <%= form_with url: sections_path, method: :post do |f| %>
      <%= f.hidden_field :source_id, value: @section.source_id %>
      <%= f.hidden_field :parent_section_id, value: @section.id %>
      <p><%= f.text_area :outline, rows: 5, placeholder: "One heading per line, indented two spaces per level" %></p>
      <p><%= f.submit "Record", class: "secondary" %></p>
    <% end %>
  </details>
<% end %>
  <% end %>
</div>

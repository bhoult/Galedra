<%# A subtree as a directory tree: open along the path to `open_ids`, claims as
    lines, the current claim marked, and the section being read marked too so a
    reader can see where they are in the whole outline. %>
<% current_section = local_assigns.fetch(:current_section, nil) %>
<%# The controller goes on the outermost list only: clicks bubble, so one
    listener covers every branch, and one per level meant a click was handled
    again by each list above it. %>
<ul <%= 'data-controller="tree"'.html_safe if local_assigns.fetch(:root, true) %>>
  <% node[:children].each do |child| %>
    <% count = tag.span(child[:counts]["claims"].to_s + (child[:pending].positive? ? "+#{child[:pending]}" : ""),
                        class: "counts",
                        title: pluralize(child[:counts]["claims"], "claim") + (child[:pending].positive? ? ", #{child[:pending]} proposed" : "")) %>
    <% heading = link_to child[:section].heading, section_path(child[:section]) %>
    <% classes = "#{'current' if child[:section].id == current_section}" %>
    <li>
      <% if child[:children].any? || child[:claims].any? %>
        <details <%= "open" if open_ids.include?(child[:section].id) %>>
          <summary class="<%= classes %>"><%= count %><%= heading %></summary>
          <div class="reveal">
            <%= render "sections/tree", node: child, open_ids: open_ids, current_claim: current_claim, current_section: current_section, seq: seq, root: false %>
          </div>
        </details>
      <% else %>
        <%# Nothing under it yet, so no disclosure triangle: an affordance that
            opens onto nothing is worse than none. It gains one when its
            extraction task is worked and its claims arrive. %>
        <p class="leaf <%= classes %>"><%= count %><%= heading %></p>
      <% end %>
    </li>
  <% end %>
  <% node[:claims].each do |claim| %>
    <li class="claim-row">
      <span class="counts state" title="<%= node[:states][claim.id].to_s.downcase.tr('_', ' ') %>"><%= state_mark(node[:states][claim.id]) %></span>
      <%= link_to claim.canonical_text.truncate(90), claim_path(claim, section: node[:section].id), class: "claim-line #{'current' if claim.id == current_claim}" %>
    </li>
  <% end %>
</ul>

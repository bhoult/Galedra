<% content_for :title, "Docs" %>
<% content_for :body_class, "document" %>
<h1>Documentation</h1>
<div class="grid two">
  <div class="card">
    <h3>For assistants and integrators</h3>
    <ul>
      <li><%= link_to "Connect an assistant", new_assistant_path %>: MCP over OAuth, or a token.</li>
      <li><%= link_to "The API", docs_path(anchor: "api") %>: every endpoint under <code>/api/v1</code>, and its <%= link_to "OpenAPI description", api_v1_openapi_path(format: :json) %>.</li>
      <li><%= link_to "Machine-readable metadata", api_v1_meta_path %>: constitution hash, system key, models, node identity.</li>
      <li><%= link_to "The skill", "#{Governance::Software::REPOSITORY}/blob/master/skills/galedra.md" %> that tells an assistant how to check and record.</li>
      <li><%= link_to "Public log", contributions_path %> and <code>GET /api/v1/log</code> for mirroring.</li>
    </ul>
  </div>
  <div class="card">
    <h3>For readers and contributors</h3>
    <ul>
      <li><%= link_to "FAQ", faq_path %></li>
      <li><%= link_to "Glossary", glossary_path %>: the kinds of work and the words for what they produce.</li>
      <li><%= link_to "Constitution", constitution_path %> (version <%= Governance::Constitution.new.version %>)</li>
      <li><%= link_to "The specification", "#{Governance::Software::REPOSITORY}/tree/master/docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc" %>: domain model, scoring, agent protocol, federation goal.</li>
      <li><%= link_to "Implementation plan and decision log", "#{Governance::Software::REPOSITORY}/blob/master/IMPLEMENTATION.md" %></li>
      <li><%= link_to "Licences", licenses_path %>: what applies to the code, the protocol, the database, and the records.</li>
      <li><%= link_to "About this instance", about_path %></li>
      <li><%= link_to "Contact", contact_path %>: how to reach the maintainer, and the routes that beat writing.</li>
    </ul>
  </div>
</div>
<hr>
<h2 id="api">The API</h2>
<p class="muted">
  Every endpoint under <code>/api/v1</code>, generated from the same
  <%= link_to "OpenAPI description", api_v1_openapi_path(format: :json) %> that clients read
  (version <%= Api::Openapi::VERSION %>), so this table cannot fall behind the code.
  Reads need no key and change nothing. Writes marked <strong>token</strong> take a connected
  assistant's bearer token; the rest carry their own Ed25519 signature.
  Most reads take <code>snapshot_seq</code> to read the record as it stood at a seq.
</p>
<% @api_reference.each do |group, rows| %>
  <h3><%= group %></h3>
  <table>
    <thead><tr><th>Endpoint</th><th>What it answers</th><th>Parameters</th></tr></thead>
    <tbody>
      <% rows.each do |row| %>
        <tr>
          <td>
            <code><%= row[:verb] %> <%= row[:path] %></code>
            <% if row[:token] %><br><span class="muted small">token</span><% end %>
          </td>
          <td><%= row[:summary] %></td>
          <td class="muted small">
            <%= row[:parameters].map { |n| tag.code(n) }.join(", ").html_safe %>
            <% if row[:body] %><%= " · JSON body" if row[:parameters].any? %><%= "JSON body" if row[:parameters].empty? %><% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
<hr>
<div class="readme"><%= @readme_html %></div>

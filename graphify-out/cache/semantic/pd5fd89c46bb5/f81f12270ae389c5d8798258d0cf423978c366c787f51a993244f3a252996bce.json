{"nodes": [{"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_12_constitution_article_xii", "label": "Article XII \u2014 Resist capture", "file_type": "concept", "source_file": "implementation/implemented/stage-23-federation-ready.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_s25", "label": "14 \u00a725 \u2014 Near-term federation readiness list", "file_type": "concept", "source_file": "implementation/implemented/stage-23-federation-ready.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_s24", "label": "14 \u00a724 \u2014 POC non-goal: do not build federation", "file_type": "concept", "source_file": "implementation/implemented/stage-23-federation-ready.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_implemented_stage_23_federation_ready_stage", "label": "Stage 23 \u2014 Federation readiness (implemented)", "file_type": "document", "source_file": "implementation/implemented/stage-23-federation-ready.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not federation: 14 \u00a724 forbids peer discovery, consensus, sharding and replication here. The single node keeps the properties 14 \u00a725 lists so a later federation stage finds nothing to undo. Each of the four gaps is one column or one small service, and none changes what a client signs, so every existing signature, hash and golden still verifies."}, {"id": "implementation_implemented_stage_23_federation_ready_node_identity", "label": "Ledger::Node \u2014 this node's identity is the system key", "file_type": "rationale", "source_file": "implementation/implemented/stage-23-federation-ready.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No separate node key: the key at seq 0 already signs every entry, so a mirror learns the node's key from the log itself. Published as `node` in /api/v1/meta with address, key id, envelope and schema versions, checkpoint protocol, data licence, visibilities in use and the software build."}, {"id": "implementation_implemented_stage_23_federation_ready_home_url", "label": "contributors.home_url \u2014 a key says which node it lives on", "file_type": "rationale", "source_file": "implementation/implemented/stage-23-federation-ready.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REGISTER_KEY accepts an optional plain http(s) origin, validated in the applier and projected; null means this node. Existing keys need no backfill, so nothing already signed changes meaning."}, {"id": "implementation_implemented_stage_23_federation_ready_visibility", "label": "contributions.visibility \u2014 the node's statement, not the signer's", "file_type": "rationale", "source_file": "implementation/implemented/stage-23-federation-ready.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A column on the log table and deliberately not part of the signed envelope: what a node may show is the node's statement, not the signer's. PUBLIC is the only value; a change of visibility remains a signed control entry (QUARANTINE, TAKEDOWN), and the app's DB role cannot UPDATE it."}, {"id": "implementation_implemented_stage_23_federation_ready_checkpoint", "label": "Signed checkpoints on pinned snapshots", "file_type": "rationale", "source_file": "implementation/implemented/stage-23-federation-ready.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Snapshots::Create signs {protocol, node_url, node_key_id, seq, entry_hash, previous_checkpoint_seq, created_at} with the system key over canonical JSON, verifiable against any public key. created_at makes checkpoints non-deterministic across nodes, which is right: a checkpoint is a node's statement at a time, not a projection, so graph_snapshots is not a projection table and not in the replay digest."}], "edges": [{"source": "implementation_implemented_stage_23_federation_ready_stage", "target": "implementation_implemented_stage_23_federation_ready_node_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-23-federation-ready.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_23_federation_ready_stage", "target": "implementation_implemented_stage_23_federation_ready_home_url", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-23-federation-ready.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_23_federation_ready_stage", "target": "implementation_implemented_stage_23_federation_ready_visibility", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-23-federation-ready.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_23_federation_ready_stage", "target": "implementation_implemented_stage_23_federation_ready_checkpoint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-23-federation-ready.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_23_federation_ready_node_identity", "target": "app_services_ledger_node_node", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file"
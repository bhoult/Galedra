{"nodes": [{"id": "implementation_implemented_after_stage_14_the_write_link_the_write_link", "label": "After Stage 14 - The write link", "file_type": "document", "source_file": "implementation/implemented/after-stage-14-the-write-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_models_investigation_receipt_investigationreceipt", "label": "InvestigationReceipt", "file_type": "code", "source_file": "implementation/implemented/after-stage-14-the-write-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_oauth_server_server", "label": "Oauth::Server", "file_type": "code", "source_file": "implementation/implemented/after-stage-14-the-write-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_implemented_after_stage_14_the_write_link_the_write_link_and_its_removal", "label": "The write link: a knowingly non-standard GET, later removed", "file_type": "rationale", "source_file": "implementation/implemented/after-stage-14-the-write-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET /api/v1/investigations/record recorded a bundle passed as base64url JSON because the alternative for a browsing-only assistant was a copy-and-paste step that loses the very users it was for; it was made acceptable by a required revocable token, idempotent receipts and filtered logs, then went tokenless, and was finally removed on the owner's instruction as a state-changing GET a crawler could trigger, needing no credential, for a host whose browser refused long URLs. Hosted assistants use OAuth over MCP instead."}, {"id": "implementation_implemented_after_stage_14_the_write_link_tokenless_writes_become_anonymous_assistants", "label": "Tokenless writes become anonymous assistants", "file_type": "rationale", "source_file": "implementation/implemented/after-stage-14-the-write-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A caller with no token becomes an anonymous assistant keyed to its address for the day, minted on first use, so the work is still signed, delegated, capped per source per day, sampled at the anonymous rate and labelled; raw custodied writes and token management still need a real token."}], "edges": [{"source": "implementation_implemented_after_stage_14_the_write_link_the_write_link", "target": "app_models_investigation_receipt_investigationreceipt", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/after-stage-14-the-write-link.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_after_stage_14_the_write_link_the_write_link", "target": "app_services_oauth_server_server", "relation": "implements", "confidence": "AMBIGUOUS", "confidence_score": 0.3, "source_file": "implementation/implemented/after-stage-14-the-write-link.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_after_stage_14_the_write_link_the_write_link", "target": "implementation_implemented_stage_13_investigate_stage_13_investigate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/after-stage-14-the-write-link.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_after_stage_14_the_write_link_the_write_link", "target": "implementation_implemented_after_stage_14_the_write_link_the_write_link_and_its_removal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/after-stage-14-the-write-link.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_after_stag
{"nodes": [{"id": "docs_license_policy_stack", "label": "Galedra licence stack", "file_type": "document", "source_file": "docs/LICENSE-POLICY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_license_policy_agpl_reference_software", "label": "Reference node software: AGPL-3.0-or-later", "file_type": "rationale", "source_file": "docs/LICENSE-POLICY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Galedra is primarily network software, so AGPL preserves source availability when a modified node is operated as a service rather than distributed; this aligns with the constitutional preference for inspectable machinery over trusted authority."}, {"id": "docs_license_policy_apache_protocol", "label": "Protocol, schemas, test vectors and SDKs: Apache-2.0", "file_type": "rationale", "source_file": "docs/LICENSE-POLICY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The protocol must be easier to adopt than the reference server so the federation is larger than one implementation; Apache-2.0 also carries an explicit patent grant, useful for widely implemented infrastructure."}, {"id": "docs_license_policy_odbl_database", "label": "Public federated database: ODbL-1.0", "file_type": "rationale", "source_file": "docs/LICENSE-POLICY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The project wants more than permission to copy the database: it wants public derivative databases to remain part of an open data commons, which ODbL's share-alike at the database layer preserves."}, {"id": "docs_license_policy_cc0_records", "label": "Individual project-authored factual records: CC0-1.0", "file_type": "rationale", "source_file": "docs/LICENSE-POLICY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Individual facts should be maximally reusable and the project should not attempt a copyright moat around facts; CC0 for contents plus ODbL for the collection keeps that distinction clean."}, {"id": "docs_license_policy_cc_by_docs", "label": "Project-authored prose and documentation: CC BY 4.0", "file_type": "rationale", "source_file": "docs/LICENSE-POLICY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_license_policy_third_party_material", "label": "Imported third-party material stays under its original licence", "file_type": "rationale", "source_file": "docs/LICENSE-POLICY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_license_policy_dco", "label": "Developer Certificate of Origin rather than a CLA", "file_type": "rationale", "source_file": "docs/LICENSE-POLICY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A DCO has low contributor friction, preserves contributor ownership, records provenance and avoids giving the owner unilateral relicensing rights; a CLA can be reconsidered if a governance or dual-licensing reason emerges."}, {"id": "docs_license_policy_rights_attestation", "label": "Rights attestation in the contribution envelope", "file_type": "rationale", "source_file": "docs/LICENSE-POLICY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_license_policy_machine_readable_spdx", "label": "Licensing must be machine-readable (SPDX)", "file_type": "rationale", "source_file": "docs/LICENSE-POLICY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_license_policy_federation_charter", "label": "Federation Charter, separate from copyright licences", "file_type": "rationale", "source_file": "docs/LICENSE-POLICY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copyright licences answer what you may legally do with the code and the database; required behavior for a recognized federation node is a governance question and belongs in a charter, not a licence."}, {"id": "docs_license_policy_no_single_operator_dependency", "label": "No single-operator dependency", "file_type": "rationale", "source_file": "docs/LICENSE-POLICY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No contributor, company or original maintainer should be able to make continued access to the public commons depend on their continued operation; the licensing structure optimizes for a commons that can outlive its founder."}, {"id": "docs_license_policy_trademark", "label": "Trademark is separate from copyright", "file_type": "rationale", "source_file": "docs/LICENSE-POLICY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_license_policy_stack", "target": "docs_license_policy_agpl_reference_software", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/LICENSE-POLICY.md", "source_location": null, "weight": 1.0}, {"source": "docs_license_policy_stack", "target": "docs_license_policy_apache_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/LICENSE-POLICY.md", "source_location": null, "weight": 1.0}, {"source": "docs_license_policy_stack", "target": "docs_license_policy_odbl_database", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/LICENSE-POLICY.md", "source_location": null, "weight": 1.0}, {"source": "docs_license_policy_stack", "target": "docs_license_poli
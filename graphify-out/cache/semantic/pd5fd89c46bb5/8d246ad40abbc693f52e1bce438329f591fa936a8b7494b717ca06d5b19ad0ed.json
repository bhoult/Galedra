{"nodes": [{"id": "implementation_implemented_stage_10_ui_stage_10_ui", "label": "Stage 10 - Hotwire UI", "file_type": "document", "source_file": "implementation/implemented/stage-10-ui.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_06_api_and_ui_api_and_ui", "label": "Spec 06 API and UI", "file_type": "document", "source_file": "implementation/implemented/stage-10-ui.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_ui_write_write", "label": "Ui::Write", "file_type": "code", "source_file": "implementation/implemented/stage-10-ui.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_helpers_display_helper_displayhelper", "label": "DisplayHelper", "file_type": "code", "source_file": "implementation/implemented/stage-10-ui.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_cards_display_rules_displayrules", "label": "Cards::DisplayRules", "file_type": "code", "source_file": "implementation/implemented/stage-10-ui.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_implemented_stage_10_ui_the_number_is_rendered_only_on_request", "label": "The number is rendered only on request", "file_type": "rationale", "source_file": "implementation/implemented/stage-10-ui.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A closed <details> still ships the probability in the HTML and the rack_test driver reads it, so the calculation card and the trace are rendered only when ?calculation=1 is present; the default claim page contains no probability at all, which is stricter than 06 SS4 rule 1 and testable without a browser."}, {"id": "implementation_implemented_stage_10_ui_server_custodied_signing_for_browser_users", "label": "Server-custodied signing for browser users", "file_type": "rationale", "source_file": "implementation/implemented/stage-10-ui.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sign-up registers a server-custodied key through the log and every UI write goes through Ui::Write, which signs an ordinary envelope with the user's unlocked key and appends it with custody SERVER, so the browser is not a special write path; the server-held-key badge makes the custody visible."}, {"id": "implementation_implemented_stage_10_ui_no_score_for_a_source_or_its_author", "label": "Descriptive counts, never a speaker score", "file_type": "rationale", "source_file": "implementation/implemented/stage-10-ui.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "06 SS6 forbids scoring a source or its author, so the source page shows counts by assessment state with the note that counts depend on extraction granularity, and nothing is ranked."}], "edges": [{"source": "implementation_implemented_stage_10_ui_stage_10_ui", "target": "app_services_ui_write_write", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-10-ui.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_10_ui_stage_10_ui", "target": "app_helpers_display_helper_displayhelper", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-10-ui.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_10_ui_stage_10_ui", "target": "app_services_cards_display_rules_displayrules", "relation": "implements", "confidence": "EXTRACTED", "confidence_score"
{"nodes": [{"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_epistemic_intermediate_representation", "label": "Epistemic Intermediate Representation (EIR)", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The compiler's persistent output format: atomic claims, evidence with exact provenance, support/contradict/qualify links, independence groups, deterministic scoring. Chosen so the reasoning behind an answer is reusable rather than re-derived by each agent."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_argument_compiler", "label": "Argument Compiler", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primary abstraction: compile a document into an auditable evidence graph rather than organize documents, citations or embeddings. Existing systems do not organize the atomic reasons for believing a claim."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_product_hypothesis", "label": "Product Hypothesis (v4)", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a71.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "P0 must give one user or small team day-one value even if nobody else contributes; public argument-mapping systems stalled on contribution cost, moderation, cold start, and readers wanting answers not graphs. Sequencing only, not a data-model change."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_relationship_to_prior_art", "label": "Relationship to Prior Art", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a71.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most primitives exist elsewhere; the novelty is the combination of signed agent work packets, atomic evidence records, explicit independence, audited task reputation and versioned reproducible scoring. Keep P0 relational (no RDF core) and treat prior art as export targets."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_nanopublications", "label": "Nanopublications", "file_type": "document", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a71.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_micropublications", "label": "Micropublications", "file_type": "document", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a71.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_w3c_prov", "label": "W3C PROV", "file_type": "document", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a71.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_claimreview", "label": "ClaimReview", "file_type": "document", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a71.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_wikidata_statements", "label": "Wikidata statements with qualifiers", "file_type": "document", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a71.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_certificate_transparency", "label": "Certificate Transparency", "file_type": "document", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a71.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_scite", "label": "scite", "file_type": "document", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a71.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_rootclaim", "label": "Rootclaim", "file_type": "document", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a71.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_claim_types", "label": "Claim Types", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_textual_claim_type", "label": "TEXTUAL claim type", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added in v4 because the seeded demo, quote verification and sermon/legal use cases depend on claims about what a text contains, which behave differently from claims about what happened. Whether TEXTUAL stays a distinct type is reserved for the owner."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_truth_evaluable", "label": "truth_evaluable", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defaults from the claim type and may be overridden only by a signed contribution; keeps non-empirical claims out of empirical scores."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_p0_scope_tier", "label": "P0 scope tier", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a75.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_p1_scope_tier", "label": "P1 scope tier", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a75.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_deferred_scope", "label": "Deferred scope", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a75.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documented in 09 and explicitly not built: inference/premise tables, entity resolution, forecast dual scoring, claim-to-claim propagation, pgvector, federation."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_show_me_why", "label": "\"Show me why\"", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministically selected: strongest counted support and contradiction, suppressed dependents, review-coverage gaps, and the single evidence addition that would move the score most."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_volunteer_agent_contribution", "label": "Volunteer agent contribution", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_non_goals", "label": "Non-Goals", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not determine ultimate truth, build one universal probability model, arbitrate moral values, replace professionals, prevent all coordinated attacks, build a blockchain, index the web, or host copyrighted text."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_private_individual_exclusion", "label": "Private-individual claims out of scope", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A public ledger of scored assertions about identifiable private people is a defamation and privacy hazard; claim creation requires a checkbox affirmation and moderators can quarantine violations."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_design_philosophy", "label": "Design Philosophy: make disagreement cheap and hidden assumptions expensive", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The log stores both 'E supports C' and 'it does not, because qualifier Q was omitted'; the scoring model resolves current weight by public, versioned rules."}], "edges": [{"source": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_relationship_to_prior_art", "target": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_nanopublications", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a71.2", "weight": 1.0}, {"source": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_relationship_to_prior_art", "target": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_micropublications", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/01-product-and-scope.md", "source_location": "\u00a71.2", "weight": 1.0}, {"source": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_relationship_to_prior_art", "target": "docs_ep
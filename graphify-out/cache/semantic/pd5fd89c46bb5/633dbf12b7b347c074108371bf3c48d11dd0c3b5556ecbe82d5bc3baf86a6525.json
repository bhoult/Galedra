n.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_ledger_appliers_quarantine_quarantine", "label": "Ledger::Appliers::Quarantine", "file_type": "code", "source_file": "implementation/implemented/stage-04-moderation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_ledger_appliers_release_quarantine_releasequarantine", "label": "Ledger::Appliers::ReleaseQuarantine", "file_type": "code", "source_file": "implementation/implemented/stage-04-moderation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_ledger_appliers_takedown_takedown", "label": "Ledger::Appliers::Takedown", "file_type": "code", "source_file": "implementation/implemented/stage-04-moderation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_implemented_stage_04_moderation_moderators_designated_outside_the_log", "label": "Moderators designated outside the log", "file_type": "rationale", "source_file": "implementation/implemented/stage-04-moderation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "09 SS15 leaves appointment open and inventing an APPOINT_MODERATOR action would extend the closed list in 02 SS3.6, so moderators are key ids in LEDGER_MODERATOR_KEY_IDS or a users.moderator flag; the list is published by /api/v1/meta and /api/v1/moderation so the power is at least visible, and the system key is never a moderator."}, {"id": "implementation_implemented_stage_04_moderation_signed_redaction_manifest", "label": "TAKEDOWN carries a signed redaction manifest", "file_type": "rationale", "source_file": "implementation/implemented/stage-04-moderation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A legally compelled deletion must still verify, so the manifest names for every projection row the fields removed and the retained values, is validated against the current rows, and leaves payload_hash, envelope_hash, entry_hash and server_signature intact; verify then reports CHAIN_VERIFIED_WITH_REDACTIONS and breaks on bytes removed any other way, and replay rebuilds the rows from the manifest."}, {"id": "implementation_implemented_stage_04_moderation_quarantine_public_stub", "label": "Quarantine leaves a public stub", "file_type": "rationale", "source_file": "implementation/implemented/stage-04-moderation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing disappears without a public trace: a quarantined claim keeps its URL and returns a stub with the quarantine seq, moderator key id, reason from the closed list and the appeal path, while text and qualifiers are withheld from every public read including old snapshots, because the point is not to serve the text."}], "edges": [{"source": "implementation_implemented_stage_04_moderation_stage_4_moderation", "target": "app_services_governance_moderation_log_moderationlog", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-04-moderation.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_04_moderation_stage_4_moderation", "target": "app_services_governance_moderators_moderators", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-04-moderation.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_04_moderation_stage_4_moderation", "target": "app_services_governance_quarantines_quarantines", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1
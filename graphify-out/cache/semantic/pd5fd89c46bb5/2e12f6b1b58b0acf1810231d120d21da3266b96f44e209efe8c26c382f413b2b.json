{"nodes": [{"id": "implementation_implemented_after_stage_14_adoption_adoption", "label": "After Stage 14 - Adoption", "file_type": "document", "source_file": "implementation/implemented/after-stage-14-adoption.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_assistants_adopt_adopt", "label": "Assistants::Adopt", "file_type": "code", "source_file": "implementation/implemented/after-stage-14-adoption.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_ledger_appliers_adopt_key_adoptkey", "label": "Ledger::Appliers::AdoptKey", "file_type": "code", "source_file": "implementation/implemented/after-stage-14-adoption.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_implemented_after_stage_14_adoption_adopt_key_with_counter_signature", "label": "ADOPT_KEY proves control of both keys", "file_type": "rationale", "source_file": "implementation/implemented/after-stage-14-adoption.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anonymous work can be put under an account later: the adopter's human key signs and the adopted key counter-signs {adopt, key_id}, so the contribution itself proves control of both. The adopted key keeps its own rows and reputation buckets and contributor pages show the link both ways; audit schedules already computed keep their stored inputs."}, {"id": "implementation_implemented_after_stage_14_adoption_openai_shaped_search_and_fetch_tools", "label": "OpenAI-shaped search and fetch tools", "file_type": "rationale", "source_file": "implementation/implemented/after-stage-14-adoption.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GPT creation left personal accounts and GPTs retire, with MCP plugins as the replacement, so two read-only tools named search and fetch were added for hosts that only allow read-and-fetch connectors, every tool got an outputSchema, and annotations mark reads read-only and writes idempotent. ChatGPT's browser strips long URLs, which is why the write link could never serve a plain chat."}], "edges": [{"source": "implementation_implemented_after_stage_14_adoption_adoption", "target": "app_services_assistants_adopt_adopt", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/after-stage-14-adoption.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_after_stage_14_adoption_adoption", "target": "app_services_ledger_appliers_adopt_key_adoptkey", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/after-stage-14-adoption.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_after_stage_14_adoption_adoption", "target": "implementation_implemented_stage_14_mcp_stage_14_mcp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/after-stage-14-adoption.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_after_stage_14_adoption_adoption", "target": "implementation_implemented_stage_12_assistants_stage_12_assistants", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/after-stage-14-adoption.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_after_stage_14_adoption_adoption", "target": "implementation_implemented_after_stage_14_adoption_adopt_key_with_counter_signature", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/after-stage-14-adoption.md", "sou
{"nodes": [{"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_federation_goal", "label": "Galedra Federation Goal", "file_type": "document", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Long-term architectural and governance direction, explicitly not a P0 requirement: federation should follow only after the core models prove useful on a single node."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_no_node_is_the_truth_authority", "label": "Foundational Principle \u2014 No Node Is the Truth Authority", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A node is a custodian, participant, verifier and replica; the originating node does not become authoritative merely because it created the contribution, and the graph must survive the loss of its origin."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_stage_p0_single_node", "label": "Federation P0 \u2014 Single Node", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prove the data model, deterministic replay, scoring, provenance and single-team workflows; no distributed-systems complexity is justified yet."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_stage_p1_independent_mirrors", "label": "Federation P1 \u2014 Independent Mirrors", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primarily about durability, not distributed write coordination."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_stage_p2_specialized_nodes", "label": "Federation P2 \u2014 Specialized Nodes", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A node does not need the entire global graph to participate."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_stage_p3_cross_replication", "label": "Federation P3 \u2014 Cross-Replication", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Important public shards should exist on multiple administratively independent nodes, resilient to abandonment, censorship and funding loss."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_stage_p4_confederated_network", "label": "Federation P4 \u2014 Confederated Network", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The original Galedra server becomes one participant among many."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_shards_not_tree", "label": "Shards, Subgraphs and Collections \u2014 Not a Strict Tree", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same atomic claim supports multiple documents, hypotheses and arguments, so federation units must not assume tree ownership; the partitioning strategy should be learned from real usage."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_globally_durable_identity", "label": "Globally Durable Object Identity", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A record must not be identified solely by a node's database row, because that node may disappear; content-addressable identity lets any node verify two copies are the same object."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_signed_checkpoints", "label": "Signed Checkpoints", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets other nodes attest they hold a verified replica, which makes replication measurable rather than assumed."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_replication_policy", "label": "Replication Across Administrative Domains", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimum replicas and minimum administrative domains are examples, not current requirements."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_asymmetric_participation", "label": "Asymmetric Storage Participation", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full archival, domain, replica, index, personal and institutional node classes: the federation should benefit from heterogeneous participation rather than requiring identical servers."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_public_private_distinguishable", "label": "Public and Private Data Must Remain Distinguishable", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The architecture must never require publication of private material merely because a federation-compatible node processed it."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_evidence_without_conclusions", "label": "Evidence Can Be Shared Without Sharing Conclusions", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nodes may agree about source, quotation, measurement and provenance while disagreeing about priors, models and final assessment; the federation should not require one global truth score. This is a feature, not fragmentation."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_personal_belief_overlay", "label": "Personal Belief Remains an Overlay", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Federation synchronizes shared epistemic objects, not private beliefs."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_conflicts_preserved", "label": "Conflicts Are Preserved", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A merge conflict in epistemic content is often information, not merely a technical problem to overwrite."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_eventual_consistency", "label": "Eventual Consistency Over Global Locking", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A volunteer global network cannot depend on one global lock, one leader, constant connectivity or one trusted timestamp server."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_federation_charter", "label": "Federation Charter", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Running compatible software does not make a node a recognized member, and membership grants no epistemic authority."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_node_reputation_operational", "label": "Node Reputation Is Operational, Not Truth Authority", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uptime and protocol compliance must never become 'this node's claims are more true because the node is prestigious'."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_failure_and_recovery", "label": "Failure and Recovery", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No critical public claim should depend indefinitely on a single origin server; reconstructibility should become a measurable network property."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_redaction_and_takedown", "label": "Redaction and Legal Takedown Across Jurisdictions", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The federation should never falsely claim byte-perfect replay where lawful deletion has made that impossible."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_anti_capture_goal", "label": "Anti-Capture Goal", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Governance does not disappear; it becomes inspectable, plural and technically difficult to monopolize."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_volunteer_economics", "label": "Volunteer Economics \u2014 Net Contribution Value", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Federation should not equate raw volume with contribution quality; a low-quality contributor can create more audit burden than value."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_discovery", "label": "Peer and Shard Discovery", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not choose a mechanism before real federation requirements are known."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_protocol_over_implementation", "label": "Protocol Is More Important Than the Reference Implementation", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The success condition is that independent implementations can participate in the same epistemic commons, not that everyone runs the Rails application."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_licensing_separation", "label": "Licensing Separation \u2014 AGPL / Apache-2.0 / ODbL / CC0", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Licenses protect openness; operational cooperation belongs in the Federation Charter rather than in a license."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_poc_non_goal", "label": "POC Non-Goal \u2014 Do Not Implement Federation Now", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Building it before validating the epistemic data model would spend effort on the wrong uncertainty; the POC must merely avoid decisions that make federation unnecessarily difficult later."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_federation_readiness", "label": "Near-Term Federation Readiness Properties", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Durable IDs, append-only signed records, explicit schema versions, canonical serialization, replayable projections and explicit rights metadata are useful even if federation never occurs."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_distributed_cairn", "label": "Guiding Vision \u2014 The Distributed Cairn", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No stone is the monument by itself; overlapping custody makes the record harder to erase or silently rewrite."}], "edges": [{"source": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_federation_goal", "target": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_stage_p0_single_node", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/14-federation-goal.md", "source_location": null, "weight": 1.0}, {"source": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_14_federation_goal_federation_goal", "target": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_
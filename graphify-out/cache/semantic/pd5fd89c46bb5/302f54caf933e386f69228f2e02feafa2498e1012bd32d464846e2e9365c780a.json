{"nodes": [{"id": "docs_profiler_2026_09_19_weaknesses_at_3000_claims_weaknesses_at_3000_claims", "label": "Profiling Run \u2014 The Weaknesses Page at 3,000 Claims", "file_type": "document", "source_file": "docs/profiler/2026-09-19-weaknesses-at-3000-claims.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 24-core workstation flatters every number, and the recommended droplet has a fraction of that; read these as the shape of the problem, not the capacity answer."}, {"id": "docs_profiler_2026_09_19_weaknesses_at_3000_claims_score_cache_n_plus_1", "label": "Score Cache N+1 \u2014 70% of the Report (FIXED via Scoring::Score.call_many)", "file_type": "concept", "source_file": "docs/profiler/2026-09-19-weaknesses-at-3000-claims.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The report paid a query to learn nothing and then computed anyway; batched into one query for the set and one chunked insert, with specs asserting the traces and hashes stay byte-identical so Invariant 4 is checked rather than assumed."}, {"id": "docs_profiler_2026_09_19_weaknesses_at_3000_claims_box_is_not_the_ceiling", "label": "The Box Is Not the Ceiling (NO ACTION NEEDED)", "file_type": "concept", "source_file": "docs/profiler/2026-09-19-weaknesses-at-3000-claims.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "162 MB a worker, flat across 300 requests; what costs is garbage collection from the churn, not residency."}, {"id": "docs_profiler_2026_09_19_weaknesses_at_3000_claims_bigdecimal_churn", "label": "BigDecimal and Canonical JSON Are the Churn, and Not a Bug (WON'T FIX)", "file_type": "concept", "source_file": "docs/profiler/2026-09-19-weaknesses-at-3000-claims.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Half the allocation is the decimals and the canonical trace that makes a score reproducible by hand. Worth reducing by scoring fewer claims, not by making scoring cheaper and less honest."}, {"id": "docs_profiler_2026_09_19_weaknesses_at_3000_claims_no_leak", "label": "Ruled Out \u2014 A Leak (NO ACTION NEEDED)", "file_type": "concept", "source_file": "docs/profiler/2026-09-19-weaknesses-at-3000-claims.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recorded as a negative so nobody spends a day on it."}, {"id": "docs_profiler_2026_09_19_weaknesses_at_3000_claims_presenter_37_queries", "label": "Graph::Presenter.claim Issues 37 Queries per Claim (OPEN)", "file_type": "concept", "source_file": "docs/profiler/2026-09-19-weaknesses-at-3000-claims.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bounded by page size rather than corpus size, which is why it has waited."}, {"id": "docs_profiler_2026_09_19_weaknesses_at_3000_claims_method_note_cache", "label": "Method Note \u2014 A Profile That Does Not Defeat the Cache Measures the Cache (FIXED in the harness)", "file_type": "concept", "source_file": "docs/profiler/2026-09-19-weaknesses-at-3000-claims.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Development's reloader, verbose query logs and log writes were a fifth of the samples, and the warm-up run populated the page's own cache."}, {"id": "docs_profiler_2026_09_19_weaknesses_at_3000_claims_same_day_correction", "label": "Same-Day Correction \u2014 Warm and Cold Paths Were Conflated (APPLIED)", "file_type": "concept", "source_file": "docs/profiler/2026-09-19-weaknesses-at-3000-claims.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 70% figure describes repeated views at one snapshot, not the first view after an append; the score cache is a table, not Rails.cache, so a cold measurement has to clear both."}, {"id": "docs_profiler_2026_09_19_weaknesses_at_3000_claims_cold_path_cost", "label": "Follow-Up \u2014 What the Cold Path Costs (PARTLY FIXED)", "file_type": "concept", "source_file": "docs/profiler/2026-09-19-weaknesses-at-3000-claims.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "About 24 queries a claim, flat as the corpus grows, from per-link quarantine, challenge, audit and independence lookups. The structural batching fix is a refactor of the path the whole project's correctness rests on, guarded only by the golden tests, so it is recorded as the next piece of work rather than attempted at the end of a session."}], "edges": [{"source": "docs_profiler_2026_09_19_weaknesses_at_3000_claims_weaknesses_at_3000_claims", "target": "docs_profiler_2026_09_19_weaknesses_at_3000_claims_score_cache_n_plus_1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/profiler/2026-09-19-weaknesses-at-3000-claims.md", "source_location": null, "weight": 1.0}, {"source": "docs_profiler_2026_09_19_weaknesses_at_3000_claims_score_cache_n_plus_1", "target": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_4", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/profiler/2026-09-19-weaknesses-at-3000-claims.md", "source_location": null, "weight": 1.0}, {"source": "docs_profiler_2026_09_19_weaknesses_at_3000_claims_weaknesses_at_3000_claims", "target": "docs_profiler_2026_09_19_weaknesses_at_3000_claims_box_is_not_the_ceiling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/profiler/2026-09-19-weaknesses-at-3000-claims.md", "source_location": null, "weight": 1.0}, {"source": "docs_profiler_2026_09
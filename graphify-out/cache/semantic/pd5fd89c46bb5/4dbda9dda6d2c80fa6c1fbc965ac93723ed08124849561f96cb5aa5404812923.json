ation": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_assistants_presenter_presenter", "label": "Assistants::Presenter", "file_type": "code", "source_file": "implementation/implemented/stage-12-assistants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_models_assistant_token_assistanttoken", "label": "AssistantToken", "file_type": "code", "source_file": "implementation/implemented/stage-12-assistants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_controllers_api_v1_custodied_controller_custodiedcontroller", "label": "Api::V1::CustodiedController", "file_type": "code", "source_file": "implementation/implemented/stage-12-assistants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_controllers_api_v1_assistants_controller_assistantscontroller", "label": "Api::V1::AssistantsController", "file_type": "code", "source_file": "implementation/implemented/stage-12-assistants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_implemented_stage_12_assistants_anonymous_identity_tier", "label": "ANONYMOUS identity tier", "file_type": "rationale", "source_file": "implementation/implemented/stage-12-assistants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The spec's tiers start at pseudonymous; ANONYMOUS was added below it so someone with no account can still contribute. Anonymous work is weighted only where the constitution allows - a 3x audit sampling factor, a per-token daily cap and rate limit, and a provisional label naming the anonymous origin - and never in claim scores, which are byte-identical regardless of tier."}, {"id": "implementation_implemented_stage_12_assistants_direct_work_delegation_permission", "label": "permissions.direct_work on a delegation", "file_type": "rationale", "source_file": "implementation/implemented/stage-12-assistants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Under 02 SS1.1a direct work by a delegated agent stays PENDING, which would have left every assistant write uncounted; a delegation may now carry direct_work: true so such work counts as the principal's own hand. The grant is a signed, visible, revocable contribution and the work is still sampled at the raised rate."}, {"id": "implementation_implemented_stage_12_assistants_assistant_tokens_are_operational", "label": "Assistant tokens live outside the log", "file_type": "rationale", "source_file": "implementation/implemented/stage-12-assistants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Like custodied_keys, assistant_tokens survives replay while the log holds the facts that matter - the agent's REGISTER_KEY, the principal's DELEGATE and any REVOKE_DELEGATION - so revocation in the log always wins over the token row; tokens are stored as SHA-256 digests and shown once."}, {"id": "implementation_implemented_stage_12_assistants_api_mints_anonymous_tokens_only", "label": "The API mints anonymous tokens only", "file_type": "rationale", "source_file": "implementation/implemented/stage-12-assistants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signed-in minting lives on the connect page so an account's key is never used without its session; the API token endpoint is rate limited by address, and because Rails fixes a limiter's cache store at class-load time the limits go through a delegator so a spec can swap in a memory store."}], "edges": [{"source": "implementation_implemented_stage_12_assistants_stag
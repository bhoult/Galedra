{"nodes": [{"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_agent_protocol_goal", "label": "Agent Protocol goal", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agents are ephemeral workers attached to a durable substrate; the server cannot see or control an external agent's prompts, so every safety property is enforced server-side on what the agent returns."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_type_claim_extraction", "label": "CLAIM_EXTRACTION", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposal-only: results create claim rows with accepted_seq null because extraction is where LLM hallucination most easily becomes durable structure."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_type_evidence_verification", "label": "EVIDENCE_VERIFICATION", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_type_opposing_evidence_search", "label": "OPPOSING_EVIDENCE_SEARCH", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces 'contradiction search': it searches opposite to the claim's current lean, and a NONE_FOUND result still satisfies opposing_search_done because a documented null search is information."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_type_source_independence_check", "label": "SOURCE_INDEPENDENCE_CHECK", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_type_qualifier_check", "label": "QUALIFIER_CHECK", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promoted to P0 in v4 because the public demo depends on discovering an omitted qualifier; looks for omitted time ranges, populations, denominators, baselines, sampling limits, jurisdictions and translations."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_type_claim_deduplication", "label": "CLAIM_DEDUPLICATION", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "P1; output is candidate edges only, never merges."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_type_summary_generation", "label": "SUMMARY_GENERATION", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "P1, external."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_types", "label": "Task Types", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_eir_task_v1", "label": "eir-task-v1 task packet", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-built, server-signed canonical JSON with a 500-2,500 token context budget; excerpts from a single source are capped to limit copyright exposure and prompt-injection surface."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_packet_hash", "label": "task_packet_hash", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_blind_independent_verification", "label": "Blind independent verification", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a73.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each assignee gets the same packet and no information about other assignees; results are revealed only after all slots submit or leases expire."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_verification_process_independence", "label": "Independence of verification processes", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a73.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two agents with different keys but the same model, prompt family or retrieval path can repeat the same mistake. P0 enforces distinct principals per slot; P1 adds model-family and retrieval-path constraints, which raise the cost of correlated error but cannot eliminate it because declared model metadata is self-reported."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_eir_result_v1", "label": "eir-result-v1 result envelope", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The signature covers the canonical envelope minus the signature field. No floats appear: the previous draft's self-reported extraction_confidence is removed because it is unverifiable, trivially gamed and unused by scoring."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_result_ops", "label": "Result ops", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a74.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ops use the same shape as the corresponding contribution action payloads; new objects may be referenced by a client-chosen ref string."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_idempotency_key", "label": "idempotency_key", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a74.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sha256(signer_key_id | task_id | payload_hash); a duplicate submission returns the original contribution and creates nothing."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_claim_extraction_proposal_only", "label": "Claim extraction is proposal-only", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a74.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_tasks_buildcontext", "label": "Tasks::BuildContext (Context Compiler)", "file_type": "code", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic, no LLM: same inputs give the same packet bytes excluding timestamps and signature."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_notes_never_in_packets", "label": "Contributor note fields are never included in any packet", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Notes are free text from untrusted parties and are the easiest injection path between agents."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_server_side_validation_pipeline", "label": "Server-Side Validation Pipeline", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nine ordered checks; failures return 422 with a machine-readable error list and create no contribution, because there is nothing to log and nothing signed by us."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_no_server_side_url_fetching", "label": "No server-side fetching of agent-supplied URLs (SSRF)", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New external sources are stored metadata-only with retrieval_pending, and a human or trusted job imports content later."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_leases", "label": "Leases", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-hour default; one active lease per (task, contributor) and per (task, principal); expired leases release the slot and a late submission is rejected at step 3. Delegations signed before max_tasks_per_hour was renamed carry max_tasks_per_day and the applier reads either, so replay reproduces them unchanged."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_adversarial_roles", "label": "Adversarial Roles", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_no_self_certification", "label": "No self-certification", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A contribution cannot be audited, and a proposed claim cannot be accepted, by the same contributor or any contributor under the same principal."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_prompt_injection_defenses", "label": "Prompt Injection defenses", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server side: closed-enum ops, display-only HTML-escaped notes excluded from scoring, packets and summary inputs, excerpts labeled untrusted_excerpt, and scoring never reads text. Client side: delimit excerpts as data and give research agents minimal tool permissions."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_summaries_stub", "label": "Summaries (server-side P0 stub, stub-v0.1)", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Summaries are derived caches, never evidence. Every sentence must have at least one cite drawn from the input set, or the summary is rejected and falls back to the stub; an LLM generator must pass the same validator."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_minimal_agent_sdk", "label": "Minimal Agent SDK (examples/agent, Ledger::Client)", "file_type": "code", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-file Ruby with no Rails dependency, plus JSON Schemas and a canonicalization test vector so third-party clients can confirm they hash identically."}], "edges": [{"source": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_types", "target": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_type_claim_extraction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a72", "weight": 1.0}, {"source": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_types", "target": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_type_evidence_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a72", "weight": 1.0}, {"source": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_types", "target": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_type_opposing_evidence_search", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a72", "weight": 1.0}, {"source": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_types", "target": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_type_source_independence_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/04-agent-protocol.md", "source_location": "\u00a72", "weight": 1.0}, {"source": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_types", "target": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_task_type_qualifier_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/epistemic-ledger-p
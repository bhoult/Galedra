{"nodes": [{"id": "implementation_implemented_stage_16_oauth_stage", "label": "Stage 16 \u2014 OAuth for connectors (implemented)", "file_type": "document", "source_file": "implementation/implemented/stage-16-oauth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OAuth adds attribution and never becomes a requirement: anonymous use stays exactly as it is. A person signs in once on Galedra's own consent page and every later call is attributed to them, with no token to copy."}, {"id": "implementation_implemented_stage_16_oauth_authorization_server", "label": "Galedra as OAuth 2.1 authorization server for its own MCP endpoint", "file_type": "rationale", "source_file": "implementation/implemented/stage-16-oauth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RFC 8414 and RFC 9728 metadata on the same host, RFC 7591 dynamic registration, S256-only PKCE, single-use ten-minute codes bound to client, redirect URI, challenge, scope and resource; refresh rotates and a replayed refresh token revokes its family. Tokens are stored as digests."}, {"id": "implementation_implemented_stage_16_oauth_two_mcp_doors", "label": "Two MCP doors: /mcp anonymous-or-token, /mcp/connect 401 challenge", "file_type": "rationale", "source_file": "implementation/implemented/stage-16-oauth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/mcp/connect answers 401 with WWW-Authenticate: Bearer resource_metadata=\u2026 until a bearer is presented, which is the discovery hook ChatGPT and Claude.ai follow. A presented but invalid credential is refused on either door rather than falling through to anonymous use, so clients refresh instead of writing anonymously by accident."}, {"id": "implementation_implemented_stage_16_oauth_durable_delegation", "label": "One durable delegation per person per client", "file_type": "rationale", "source_file": "implementation/implemented/stage-16-oauth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The durable fact stays in the log: the first grant mints one AssistantToken through Assistants::Connect (agent key, logged DELEGATE, daily cap), and every access token maps onto it, so the revocation path is the one that already exists. Owner decision: tokens and delegations do not expire (100 years); revocation is the only end."}, {"id": "implementation_implemented_stage_16_oauth_read_scope", "label": "galedra:read scope, enforced on writes", "file_type": "rationale", "source_file": "implementation/implemented/stage-16-oauth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A connector may ask for read-only; REST writes then answer 403 INSUFFICIENT_SCOPE with the RFC 6750 challenge and MCP writing tools return a tool error naming the scope to reconnect with, so the refusal tells the assistant how to fix it."}], "edges": [{"source": "implementation_implemented_stage_16_oauth_stage", "target": "implementation_implemented_stage_16_oauth_authorization_server", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-16-oauth.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_16_oauth_stage", "target": "implementation_implemented_stage_16_oauth_two_mcp_doors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-16-oauth.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_16_oauth_stage", "target": "implementation_implemented_stage_16_oauth_durable_delegation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-16-oauth.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_16_oauth_stage", "target": "implementation_implemented_stage_16_oauth_read_scope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-16-oauth.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_16_oauth_authorization_server", "target": "app_services_oauth_server_server", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "implementation/implemented/stage-16-oauth.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_16_oauth_durable_delegation", "target": "app_services_assistants_connect_connect", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-16-oauth.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_16_oauth_durable_delegation", "target": "app_controllers_concerns_assistant_auth_assistantauth", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-16-oauth.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_16_oauth_two_mcp_doors", "target": "app_controllers_mcp_controller_mcpcontroller", "relation": "implements", "confidence": "AMBIGUOUS", "confidence_score": 0.3, "source_file": "implementation/implemented/stage-16-oauth.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_16_oauth_stage", "target": "implementation_implemented_stage_15_topics_anonymous_consent", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "implementation/implemented/stage-16-oauth.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "connector_attribution_flow", "label": "Attributing a connected assistant's writes: consent, OAuth grant, delegation, bearer, cap", "nodes": ["implementation_implemented_stage_15_topics_anonymous_consent", "implementation_implemented_stage_16_oauth_authorization_server", "implementation_implemented_stage_16_oauth_two_mcp_doors", "implementation_implemented_stage_16_oauth_durable_delegation", "implementation_implemented_stage_16_oauth_read_scope", "implementation_implemented_stage_21_large_requests_named_assistant_cap"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-16-oauth.md"}]}
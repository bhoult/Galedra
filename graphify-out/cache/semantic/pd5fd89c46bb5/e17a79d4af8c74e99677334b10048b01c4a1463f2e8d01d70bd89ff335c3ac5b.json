{"nodes": [{"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_12_constitution_article_ii", "label": "Article II \u2014 Evidence must be traceable to a source", "file_type": "concept", "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_s7", "label": "01 \u00a77 \u2014 No page text in the log", "file_type": "concept", "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_11", "label": "Invariant 11 \u2014 Untrusted text stays inert; the server never fetches agent-supplied URLs", "file_type": "concept", "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_implemented_stage_17_retrieval_stage", "label": "Stage 17 \u2014 Source retrieval by a trusted job (implemented)", "file_type": "document", "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A source recorded by link is later checked by Galedra itself, under Galedra's own rules. The reader's record is never changed; the server's finding sits beside it. An assistant can never ask for the fetch and never steers it: the only input is a link already in the log."}, {"id": "implementation_implemented_stage_17_retrieval_retrieve_source", "label": "RETRIEVE_SOURCE control contribution", "file_type": "rationale", "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System-signed, takes effect on append, projecting to source_retrievals in PROJECTION_MODELS so digests, replay, verify and TAKEDOWN redaction cover it. Page text is never stored: only the hash, the size and one finding per quoted location (VERBATIM, NORMALIZED, NOT_FOUND, UNSUPPORTED). The source keeps the reader's own content_hash; the server's hash is shown alongside, never overwriting it."}, {"id": "implementation_implemented_stage_17_retrieval_no_fetch_on_request", "label": "Never fetch on an assistant's request (SSRF and untrusted input)", "file_type": "rationale", "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An assistant's write must not make Galedra act on untrusted input: a URL in a bundle could point into the network behind the tunnel, at something enormous, or at a page that differs per visitor. Hosts are resolved before connecting and private, loopback, link-local, CGNAT, multicast, reserved and IPv6-local addresses refused, re-checked on every redirect."}, {"id": "implementation_implemented_stage_17_retrieval_fetcher_seam", "label": "Sources::Retrieve::Fetcher \u2014 a one-method seam so tests touch no network", "file_type": "rationale", "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The whole fetch is behind `get(uri)`, so specs use canned pages and a fake resolver. Five redirects, 2 MB streamed with an abort, 5 s open and 10 s read, a fixed user agent naming build and node, one fetch per host per minute through Rails.cache, robots.txt honoured with longest-match wins."}, {"id": "implementation_implemented_stage_17_retrieval_finding_not_a_check", "label": "A retrieval finding is a label, not a scored review check", "file_type": "rationale", "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deviation from the plan's wording: review checks are part of the scored checklist and must not change (Article XI reading), so the confirmation is a label beside them, derived at read time. A NOT_FOUND excerpt adds a note to the claim's open EVIDENCE_VERIFICATION task rather than moving any score."}, {"id": "implementation_implemented_stage_17_retrieval_replaying_guard", "label": "Ledger.replaying? \u2014 enqueue on live append only", "file_type": "rationale", "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The CREATE_SOURCE applier must enqueue a fetch on a live append but never while ledger:replay rebuilds the projections, or a rebuild would go out to the network; the job is idempotent per (source_id, created_seq) as well."}], "edges": [{"source": "implementation_implemented_stage_17_retrieval_stage", "target": "implementation_implemented_stage_17_retrieval_retrieve_source", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_17_retrieval_stage", "target": "implementation_implemented_stage_17_retrieval_no_fetch_on_request", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_17_retrieval_stage", "target": "implementation_implemented_stage_17_retrieval_fetcher_seam", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_17_retrieval_stage", "target": "implementation_implemented_stage_17_retrieval_finding_not_a_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_17_retrieval_stage", "target": "implementation_implemented_stage_17_retrieval_replaying_guard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_17_retrieval_stage", "target": "app_services_sources_retrieve_retrieve", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_17_retrieval_fetcher_seam", "target": "app_services_sources_retrieve_fetcher", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_17_retrieval_retrieve_source", "target": "app_models_source_retrieval_sourceretrieval", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_17_retrieval_retrieve_source", "target": "app_services_ledger_ids_ids", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-17-retrieval.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_
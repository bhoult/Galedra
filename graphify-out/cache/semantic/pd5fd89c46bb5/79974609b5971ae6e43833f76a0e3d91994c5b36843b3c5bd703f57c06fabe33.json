ce_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_ledger_appliers_delegate_delegate", "label": "Ledger::Appliers::Delegate", "file_type": "code", "source_file": "implementation/implemented/stage-02-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_ledger_appliers_revoke_key_revokekey", "label": "Ledger::Appliers::RevokeKey", "file_type": "code", "source_file": "implementation/implemented/stage-02-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_ledger_appliers_revoke_delegation_revokedelegation", "label": "Ledger::Appliers::RevokeDelegation", "file_type": "code", "source_file": "implementation/implemented/stage-02-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_implemented_stage_02_log_hash_chain_and_entry_hash", "label": "Hash chain and entry_hash", "file_type": "rationale", "source_file": "implementation/implemented/stage-02-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "entry_hash = sha256(canonical({seq, prev_hash, envelope_hash, received_at})) per 02 SS1.2; genesis prev_hash is 64 zeros with no prefix and received_at is floored to microseconds before hashing so the stored timestamptz round-trips and the chain still recomputes."}, {"id": "implementation_implemented_stage_02_log_deterministic_projection_ids", "label": "Deterministic projection ids", "file_type": "rationale", "source_file": "implementation/implemented/stage-02-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replay must reproduce projection rows byte for byte (02 SS1.1 rule 3), which UUIDv7 cannot do, so log rows keep UUIDv7 while projection rows get Ledger::Ids.derive(contribution_id, kind), a UUID with version nibble 8 derived from sha256; projection tables also carry no timestamps because created_seq is the time axis."}, {"id": "implementation_implemented_stage_02_log_custody_material_moved_off_contributors", "label": "Custody material moved off contributors", "file_type": "rationale", "source_file": "implementation/implemented/stage-02-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "02 SS3.1 puts encrypted_private_key and user_id on contributors, but replay truncates projections and the log cannot rebuild key material, so custody lives in custodied_keys, which is not a projection and survives replay; no foreign keys point at projection tables so a single TRUNCATE still works."}, {"id": "implementation_implemented_stage_02_log_idempotency_key", "label": "Idempotency key over signer, task, and payload hash", "file_type": "rationale", "source_file": "implementation/implemented/stage-02-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "idempotency_key = sha256(signer_key_id|task_id|payload_hash) per 02 SS3.1, and the duplicate check runs before any other validation so a resubmission always returns the original even for a REGISTER_KEY whose key is by then registered; the consequence is that a byte-identical payload can never make a second distinct claim."}, {"id": "implementation_implemented_stage_02_log_append_only_database_role", "label": "Append-only database role galedra_app", "file_type": "rationale", "source_file": "implementation/implemented/stage-02-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grants are not in schema.rb, so Ledger::DatabaseRole.ensure_all! re-applies them after every db task and schema load: everything granted, then UPDATE, DELETE and TRUNCATE revoked on contributions with UPDATE (current_status) granted back; runtime connections SET ROLE, and as_owner is the explicit escape hatch used by takedown and by tests that corrupt rows."}, {"id": "implementation_implemented_stage_02_log_block_scoped_connections", "label": "Block-scoped connections for concurrent appends", "file_type": "rationale", "source_file": "implementation/implemented/stage-02-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rails 7.2+ leases a connection to the thread for good when code calls Model.connection, so the first Append starved a 50-thread test after five appends; services now use with_connection and fifty concurrent appends complete in about 0.2 s."}], "edges": [{"source": "implementation_implemented_stage_02_log_stage_2_log", "target": "app_services_ledger_append_append", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-02-log.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_02_log_stage_2_log", "target": "app_services_ledger_apply_apply", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-02-log.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_02_log_stage_2_log", "target": "app_services_ledger_verify_verify", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-02-log.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_02_log_stage_2_log", "target": "app_services_ledger_replay_replay", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-02-log.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_02_log_sta
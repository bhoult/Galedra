{"nodes": [{"id": "implementation_implemented_stage_14_mcp_stage_14_mcp", "label": "Stage 14 - MCP, OpenAPI, and the skill", "file_type": "document", "source_file": "implementation/implemented/stage-14-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_mcp_server_server", "label": "Mcp::Server", "file_type": "code", "source_file": "implementation/implemented/stage-14-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_api_openapi_openapi", "label": "Api::Openapi", "file_type": "code", "source_file": "implementation/implemented/stage-14-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_cards_image_image", "label": "Cards::Image", "file_type": "code", "source_file": "implementation/implemented/stage-14-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_controllers_api_v1_openapi_controller_openapicontroller", "label": "Api::V1::OpenapiController", "file_type": "code", "source_file": "implementation/implemented/stage-14-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_implemented_stage_14_mcp_mcp_served_by_rails_over_json_rpc", "label": "MCP served by Rails itself", "file_type": "rationale", "source_file": "implementation/implemented/stage-14-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /mcp takes one JSON-RPC 2.0 message and answers with JSON - streamable HTTP without server push, GET /mcp is 405 - so no separate process or gem is needed; reads are open like the rest of the public API and the writing tools need a bearer token, and applier rejections come back as isError results with the usual codes rather than protocol errors."}, {"id": "implementation_implemented_stage_14_mcp_the_skill_lives_once", "label": "The skill lives once and is rendered per host", "file_type": "rationale", "source_file": "implementation/implemented/stage-14-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "skills/galedra.md is the single source rendered into the Claude, ChatGPT and generic forms by a rake task, with a spec failing when the generated files are stale, so the same procedure reaches every host; GALEDRA_URL stays a placeholder because one text serves every deployment."}, {"id": "implementation_implemented_stage_14_mcp_share_card_carries_no_probability", "label": "Share cards carry no probability", "file_type": "rationale", "source_file": "implementation/implemented/stage-14-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 1200x630 image shows the plain headline, the claim, say instead, and the model, snapshot and review checks in small print - no number anywhere (rule 3) and no colour coding (rule 12); quarantined claims 404 here rather than render a stub image, the conservative reading of a reserved decision."}, {"id": "implementation_implemented_stage_14_mcp_one_bundle_schema_for_two_surfaces", "label": "The bundle schema is shared by OpenAPI and MCP", "file_type": "rationale", "source_file": "implementation/implemented/stage-14-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hand-maintained OpenAPI 3.1 document covers the public reads and the bearer writes for GPT Actions and plain HTTP clients, and it shares the bundle schema with the MCP tool so the two surfaces cannot drift apart; a spec walks every GET path in it."}], "edges": [{"source": "implementation_implemented_stage_14_mcp_stage_14_mcp", "target": "app_service
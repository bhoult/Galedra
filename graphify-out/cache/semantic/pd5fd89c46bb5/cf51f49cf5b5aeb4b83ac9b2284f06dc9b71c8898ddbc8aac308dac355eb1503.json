{"nodes": [{"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_threat_model", "label": "Threat Model", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eighteen adversarial threats each paired with a P0 mitigation. The POC does not claim to solve selective omission, agent collusion, correlated AI errors or low-quality donated agents; it must avoid the naive 'more validators = more truth' model."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_threat_correlated_ai_errors", "label": "Correlated AI errors", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same model, prompt or retrieval path making the same mistake under different keys; mitigated partially by distinct principals per slot and recorded software metadata, which is unverifiable."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_threat_sybil_identities", "label": "Sybil identities", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_threat_fabricated_evidence", "label": "Fabricated evidence / fake citations", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_threat_evidence_double_counting", "label": "Evidence double-counting", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_threat_silent_history_rewriting", "label": "Silent history rewriting", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_keys_and_custody", "label": "Keys and Custody (Ed25519)", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server custody for browser UI users is an honest, labeled compromise for a POC: the previous draft required signatures but gave UI users no way to sign. Never hand-roll primitives."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_custody_self", "label": "SELF custody", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_custody_server", "label": "SERVER custody", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_custody_system", "label": "SYSTEM custody (system key)", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lives outside the database in environment/credentials; its public key is published in GET /api/v1/meta."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_signed_contributions", "label": "Signed Contributions (RFC 8785)", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_delegation_and_revocation", "label": "Delegation and Revocation", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_compromised_since", "label": "compromised_since", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contributions from a key after the declared compromise seq are automatically marked CHALLENGED and queued for audit; they keep counting only if audits confirm them."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_reputation_roll_up", "label": "Reputation roll-up to the principal", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closes the loophole where a principal could launder bad agent history by spinning up new agent keys; revoking a compromised agent does not erase failures before compromised_since."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_transparency_log", "label": "Transparency Log", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET /api/v1/log streams entries so third parties can mirror and verify the chain; the head hash can later be anchored externally. No blockchain."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_reputation_definition", "label": "Reputation - what it means", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The audited, empirically observed rate at which an identity performs a specific task type correctly in a specific domain. It does not mean the identity's beliefs are likely true and in v0.1 does not influence claim scores; it drives audit sampling, task eligibility and display."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_reputation_calculation", "label": "Reputation Calculation (Beta-Binomial)", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per (contributor, task_type, domain) from active reputation_events. The prior changed from Beta(2,2) to Beta(1,1) because reputation no longer multiplies evidence and the display should not suggest a synthetic track record; mean is always shown with n and a 'limited history' label below n = 3."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_audit_result_confirmed", "label": "Audit result CONFIRMED", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_audit_result_minor_error", "label": "Audit result MINOR_ERROR", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_audit_result_substantive_error", "label": "Audit result SUBSTANTIVE_ERROR", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_audit_result_fabrication", "label": "Audit result FABRICATION", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_audit_result_unresolved", "label": "Audit result UNRESOLVED", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_auditor_selection", "label": "Auditor Selection", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A different principal from the target, with n >= 5 and mean >= 0.8 in AUDIT for the domain or human ESTABLISHED+ tier; auditors see the target and its excerpt, not the target's reputation."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_audit_policy", "label": "Audit Policy", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_audit_sampling_determinism", "label": "Deterministic audit sampling", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The decision is sha256(entry_hash + policy_version) < audit_probability * 2^256, so anyone can recompute whether a contribution should have been sampled and operators cannot quietly skip audits."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_audit_input_anchoring", "label": "Audit input anchoring (v4 fix)", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every input is evaluated as of the contribution's own seq and stored in audit_schedules, so later audits, new edges or reputation changes cannot retroactively change whether an old contribution should have been sampled."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_outcome_is_unusual", "label": "outcome_is_unusual", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_audit_result_effects", "label": "Effect of an audit result", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_appeals_re_audit", "label": "Appeals (RE_AUDIT)", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If a re-audit disagrees, the first audit is invalidated and the target's rows are restored by a new ACCEPT with a new created_seq; history shows the gap."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_high_impact_policy", "label": "High-Impact Policy (P0 placeholder)", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Confirming audits required before provisional clears scale with downstream_count; thresholds are placeholders and live in config."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_downstream_count", "label": "downstream_count", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_sybil_resistance", "label": "Sybil Resistance", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cryptographic identity alone does not stop one actor from creating 10,000 keys; nothing in scoring counts heads, slots are unique per principal, new identities are heavily audited and rate-limited, and evidence must be reproducible from stored bytes."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_model_and_software_provenance", "label": "Model and Software Provenance", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a712", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recording software and delegation_id enables systemic-error audits like 'all links created by model X, prompt v1' and ensures no model family becomes a privileged source (Art. XIV)."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_abuse_handling_and_moderation", "label": "Abuse Handling and Moderation", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moderation is never silent: quarantined content leaves a public stub at the same URL with moderator key, date, reason category and appeal path, and scores changed by a quarantine say so in their trace. Moderator actions are auditable and appealable."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_quarantine_reason_categories", "label": "Quarantine reason categories", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closed list: PRIVATE_INDIVIDUAL, PERSONAL_DATA, UNLAWFUL_CONTENT, UNLICENSED_MATERIAL, SPAM. Disagreement with a claim or its politics is never a quarantine reason."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_scoring_model_releases", "label": "Scoring Model Releases", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a714", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weights never change without a new version and old versions stay loadable so old traces reproduce; a release is rejected if its review_checklist declares a check no available task type can satisfy."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_privacy", "label": "Privacy", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a715", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contributors are never required to expose real name, location, employer or IP history; do not fingerprint, and store IPs only in short-retention request logs, never in the ledger. Pseudonymous reputation is a feature."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_suspicious_contribution_clusters", "label": "Suspicious Contribution Clusters (P1)", "file_type": "concept", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/05-identity-reputation-and-security.md", "source_location": "\u00a716", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Article XXII report on audit-failure rates by principal, model family, prompt version and time window; it raises audit rates through an anomaly factor and never invalidates anything by itself."}], "edges": [{"source": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_05_identity_reputation_and_security_thre
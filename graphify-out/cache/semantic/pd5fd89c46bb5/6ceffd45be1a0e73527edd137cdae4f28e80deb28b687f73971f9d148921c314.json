{"nodes": [{"id": "implementation_implemented_p1_assistants_p1_assistants", "label": "P1 - Assistants as contributors", "file_type": "document", "source_file": "implementation/implemented/p1-assistants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_implemented_p1_assistants_p1_design_rules", "label": "P1 design rules for connected assistants", "file_type": "rationale", "source_file": "implementation/implemented/p1-assistants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The target user is about to repost something and will not learn a vocabulary, so: one instruction and one link back; assistants cannot hold keys, so the server signs for them under a delegation naming the assistant; Galedra stores a link plus a content hash and never fetches URLs or stores a page's full text; anonymous contributions are weighted in sampling, priority, rate limits and labelling but never in scores, because identity does not replace evidence; and every result leads with a plain headline and a what-to-say-instead line before any number."}], "edges": [{"source": "implementation_implemented_p1_assistants_p1_assistants", "target": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_07_poc_roadmap_and_acceptance_poc_roadmap_and_acceptance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/p1-assistants.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_p1_assistants_p1_assistants", "target": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_01_product_and_scope_product_and_scope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/p1-assistants.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_p1_assistants_p1_assis
{"nodes": [{"id": "implementation_implemented_stages_20_22_outlines_outline_vocabulary", "label": "Outline, section, root, leaf, placement \u2014 the fixed vocabulary", "file_type": "rationale", "source_file": "implementation/implemented/stages-20-22-outlines.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed once so no synonym appears anywhere: an outline is a tree of sections over one source; a root section has no parent, a leaf none below it, and a claim is placed in a section by a placement. Not \"chapter\", \"topic\" (taken by Stage 15), \"collection\" (reserved by 14 for federation), \"folder\" or \"dossier\"."}, {"id": "implementation_implemented_stages_20_22_outlines_large_source_goal", "label": "Large sources: record the structure first, then ask", "file_type": "rationale", "source_file": "implementation/implemented/stages-20-22-outlines.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Galedra so far took a meme or a paragraph. When the whole check will not fit in about a quarter of an hour, the assistant records the structure (source, nested outline, one extraction task per leaf) so other volunteers can take the work in pieces, then asks whether to start on the research itself. Split into three tags so each leaves the demo goldens, replay and verify unchanged and can be reviewed alone."}], "edges": [{"source": "implementation_implemented_stage_20_sections_stage", "target": "implementation_implemented_stages_20_22_outlines_outline_vocabulary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stages-20-22-outlines.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_21_large_requests_stage", "target": "implementation_implemented_stages_20_22_outlines_outline_vocabulary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stages-20-22-outlines.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_22_outline_share_stage", "target": "implementation_implemented_stages_20_22_outlines_outline_vocabulary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stages-20-22-outlines.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stages_20_22_outlines_large_source_goal", "target": "implementation_implemented_stages_20_22_outlines_outline_vocabulary", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stages-20-22-outlines.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "outline_large_source_flow", "label": "The large-source flow: outline, extraction tasks, volunteer answers, acceptance, share", "nodes": ["implementation_implemented_stages_20_22_outlines_large_source_goal", "implementation_implemented_stage_20_sections_create_section", "implementation_implemented_stage_21_large_requests_create_outline", "implementation_implemented_stage_21_large_requests_size_rule", "implementation_implemented_stage_22_outline_share_share_line_form", "implementation_implemented_stage_30_section_text_anchor_reading_split"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stages-20-22-outlines.md"}]}
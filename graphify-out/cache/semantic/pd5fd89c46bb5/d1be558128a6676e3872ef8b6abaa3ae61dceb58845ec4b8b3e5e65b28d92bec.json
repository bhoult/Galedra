ll, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_models_affiliation_request_affiliationrequest", "label": "AffiliationRequest", "file_type": "code", "source_file": "implementation/implemented/personal-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_models_custom_affiliation_customaffiliation", "label": "CustomAffiliation", "file_type": "code", "source_file": "implementation/implemented/personal-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_affiliations_affiliations", "label": "Affiliations", "file_type": "code", "source_file": "implementation/implemented/personal-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_affiliations_resolve_resolve", "label": "Affiliations::Resolve", "file_type": "code", "source_file": "implementation/implemented/personal-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_jobs_resolve_affiliation_request_job_resolveaffiliationrequestjob", "label": "ResolveAffiliationRequestJob", "file_type": "code", "source_file": "implementation/implemented/personal-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_jobs_settle_lone_verdicts_job_settleloneverdictsjob", "label": "SettleLoneVerdictsJob", "file_type": "code", "source_file": "implementation/implemented/personal-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_models_user_affiliation_useraffiliation", "label": "UserAffiliation", "file_type": "code", "source_file": "implementation/implemented/personal-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_models_bug_report_bugreport", "label": "BugReport", "file_type": "code", "source_file": "implementation/implemented/personal-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_models_feature_request_featurerequest", "label": "FeatureRequest", "file_type": "code", "source_file": "implementation/implemented/personal-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_implemented_personal_views_personal_views_stay_outside_the_log", "label": "Personal views stay outside the log", "file_type": "rationale", "source_file": "implementation/implemented/personal-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "personal_assessments is never fed to Ledger::Apply, scoring, packets or summaries; the claim page shows the person's own view and the aggregate below the assessment, both carrying the fixed sentence that views are personal belief, not evidence, and visibility stays PRIVATE so a stance is never shown with a name."}, {"id": "implementation_implemented_personal_views_affiliation_breakdown_min_group", "label": "Affiliation breakdown hidden below MIN_GROUP", "file_type": "rationale", "source_file": "implementation/implemented/personal-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An affiliation is shown only when at least five people holding it registered a view on that claim, so a small group can never expose anyone; special-category data is self-declared, optional and deletable, and the table says how groups split, never which group is right (Article XVIII)."}, {"id": "implementation_implemented_personal_views_consensus_not_admins", "label": "Consensus, not admins", "file_type": "rationale", "source_file": "implementation/implemented/personal-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There are no paid admins, so review is settled by agreement: one verdict per principal per item, the author never votes on their own text (the 04 SS3.1 distinct-principals rule and Article XI's no self-certification), two agreeing verdicts settle at once, and a single uncontradicted verdict settles after 48 hours so a quiet queue drains with one honest reviewer. No leases, because several principals judging the same item is the point."}, {"id": "implementation_implemented_personal_views_off_log_text_is_reviewed_off_log", "label": "Off-log free text is reviewed off the log", "file_type": "rationale", "source_file": "implementation/implemented/personal-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every non-empty free-text field written outside the log is queued for review; log content is not queued because it has quarantine and takedown. It is deliberately not a ledger task type: 04 SS2 task types target claims and sources and their results are signed ops, so reviewing bug reports through the log would put moderation of bug reports into the epistemic record. OFFENSIVE replaces the field with a redaction marker and keeps the original for admins."}, {"id": "implementation_implemented_personal_views_affiliation_requests_resolved_then_reviewed", "label": "Affiliation requests resolved by rules, escalated to consensus", "file_type": "rationale", "source_file": "implementation/implemented/personal-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The LLM boundary maps a request to EXACT, ALIAS, SIMILAR or NONE; EXACT and ALIAS are applied at once by a job while SIMILAR and NONE go to consensus review, and the agreed verdict settles every pending request for the same normalized text together. A real adapter must return the same shape and is never trusted beyond EXACT and ALIAS without a person."}], "edges": [{"source": "implementation_implemented_personal_views_personal_views", "target": "app_models_personal_assessment_personalassessment", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/personal-views.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_personal_views_personal_views", "target": "app_services_personal_assessments_breakdown_breakdown", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/personal-views.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_personal_views_personal_views", "target": "app_services_reviews_consensus_consensus", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/personal-views.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_personal_views_personal_views", "target": "app_models_content_review_contentreview", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/personal-views.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_personal_views_personal_views", "target": "app_models_affiliation_request_affiliationrequest", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/personal-views.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_personal_views_personal_views", "target": "app_models_custom_affiliation_customaffiliation", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/personal-views.md", "s
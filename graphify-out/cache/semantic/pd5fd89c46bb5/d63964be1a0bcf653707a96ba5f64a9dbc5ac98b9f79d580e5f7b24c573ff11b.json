{"nodes": [{"id": "implementation_implemented_after_p0_landing_page_and_visual_design_landing_page_and_visual_design", "label": "After P0 - Landing page and visual design", "file_type": "document", "source_file": "implementation/implemented/after-p0-landing-page-and-visual-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_implemented_after_p0_landing_page_and_visual_design_constitution_rendered_from_the_hashed_bytes", "label": "The constitution page renders the bytes the hash covers", "file_type": "rationale", "source_file": "implementation/implemented/after-p0-landing-page-and-visual-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET /constitution renders CONSTITUTION.md itself, the bytes the published constitution_hash covers, parsed and converted at render time, so what a visitor reads is what the hash certifies and no spec file had to be edited; the footer carries the constitution version and hash on every page."}, {"id": "implementation_implemented_after_p0_landing_page_and_visual_design_decorative_graph_reads_no_ledger_data", "label": "The landing animation is decorative and reads no ledger data", "file_type": "rationale", "source_file": "implementation/implemented/after-p0-landing-page-and-visual-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A canvas graph grows behind the landing page purely as decoration: it reads no ledger data, pauses when the tab is hidden and shows one static frame under prefers-reduced-motion, and rule 12 still holds across the new stylesheet - no true/false colours and no badges of correctness."}], "edges": [{"source": "implementation_implemented_after_p0_landing_page_and_visual_design_landing_page_and_visual_design", "target": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_08
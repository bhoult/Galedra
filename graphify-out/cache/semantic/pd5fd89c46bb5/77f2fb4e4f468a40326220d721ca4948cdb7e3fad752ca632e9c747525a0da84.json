{"nodes": [{"id": "docs_hosting_plan", "label": "Galedra Hosting and Deployment Plan", "file_type": "document", "source_file": "docs/HOSTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hosting_digitalocean_first", "label": "Why DigitalOcean first", "file_type": "rationale", "source_file": "docs/HOSTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preferred over raw AWS EC2 for the first node because it exposes fewer infrastructure concepts while still providing ordinary Linux VMs, private networking and managed PostgreSQL; the first deployment optimizes for developer attention, predictable cost, simple operations, easy recovery and portability."}, {"id": "docs_hosting_kamal_deployment", "label": "Deployment with Kamal 2", "file_type": "document", "source_file": "docs/HOSTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kamal on a small cloud VM with managed PostgreSQL is the plan for the first public node, but config/deploy.yml does not exist yet; compose.production.yaml is what runs today and stays the fallback for a volunteer node."}, {"id": "docs_hosting_portability_rule", "label": "Portability rule: no provider-specific identity", "file_type": "rationale", "source_file": "docs/HOSTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primary keys are UUIDv7 or derived from the contribution that created the row; every entry carries its content and chain hash, and Stage 23 added node identity, home_url on every key, explicit visibility and signed checkpoints, so the epistemic object under a human-facing URL is portable between nodes."}, {"id": "docs_hosting_expensive_ai_work_off_central_server", "label": "Expensive AI work must stay off the central server", "file_type": "rationale", "source_file": "docs/HOSTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A matter of principle before cost: the server only issues task packets, verifies signatures, validates schemas, appends, projects, audits, rescores, settles reviews and serves. Research runs on contributor machines and connected assistants, which keeps hosting cheap and matches the volunteer-network design."}, {"id": "docs_hosting_backups_and_restore", "label": "Backups and restore procedure", "file_type": "document", "source_file": "docs/HOSTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hosting_approval_boundary", "label": "What Claude must not do without explicit approval", "file_type": "rationale", "source_file": "docs/HOSTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Irreversible account-level actions \u2014 purchasing cloud services, changing production DNS, destroying infrastructure, deleting backups, rotating the system key, exposing PostgreSQL \u2014 require explicit authorization; infrastructure preparation in the repository does not."}, {"id": "docs_hosting_acceptance_criteria", "label": "Deployment acceptance criteria", "file_type": "document", "source_file": "docs/HOSTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hosting_guiding_principle", "label": "Guiding principle: the first host should be deliberately ordinary", "file_type": "rationale", "source_file": "docs/HOSTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Complexity should be spent on the epistemic model, not cloud infrastructure; the infrastructure succeeds when it is boring, inexpensive, recoverable, portable, agent-operable and easy to replace."}], "edges": [{"source": "docs_hosting_plan", "target": "compose_production_app", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HOSTING.md", "source_location": null, "weight": 1.0}, {"source": "docs_hosting_plan", "target": "readme_serving_from_home", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HOSTING.md", "source_location": null, "weight": 1.0}, {"source": "docs_hosting_plan", "target": "docs_hosting_digitalocean_first", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HOSTING.md", "source_location": null, "weight": 1.0}, {"source": "docs_hosting_plan", "target": "docs_hosting_kamal_deployment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HOSTING.md", "source_location": null, "weight": 1.0}, {"source": "docs_hosting_expensive_ai_work_off_central_server", "target": "claude_invariant_18_no_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HOSTING.md", "source_location": null, "weight": 1.0}, {"source": "docs_hosting_portability_rule", "target": "claude_canonical_vocabulary", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/HOSTING.md", "source_location": null, "weight": 1.0}, {"source": "docs_hosting_acceptance_criteria", "target": "readme_demo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HOSTING.md", "source_location": null, "weight": 1.0}, {"source": "docs_hosting_acceptance_criteria", "target": "docs_hosting_backups_and_restore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HOSTING.md", "source_location": null, "weight": 1.0}, {"source": "docs_hosting_acceptance_criteria", "target": "readme_contrib
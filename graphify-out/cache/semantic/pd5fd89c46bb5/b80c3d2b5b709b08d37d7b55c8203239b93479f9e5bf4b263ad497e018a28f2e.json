{"nodes": [{"id": "implementation_implemented_claim_references_claim_references", "label": "Claim references - how often a claim is met", "file_type": "document", "source_file": "implementation/implemented/claim-references.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_models_claim_reference_claimreference", "label": "ClaimReference", "file_type": "code", "source_file": "implementation/implemented/claim-references.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_implemented_claim_references_attention_is_not_evidence", "label": "Claim reference counts live outside the log", "file_type": "rationale", "source_file": "implementation/implemented/claim-references.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A count is not an epistemic fact: claim_references is one row per claim, kind and day, counted by an upsert that never raises so a failed count cannot break the read or write it rides on, and it is not signed, not replayed and never reaches scoring. Crawlers inflate VIEWED and SHARED, so CHECKED and LOOKED_UP are the cleaner signals."}, {"id": "implementation_implemented_claim_references_most_met_not_top_lies", "label": "Ordered by how often a claim was met, never by how wrong it is", "file_type": "rationale", "source_file": "implementation/implemented/claim-references.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "06 SS4 rule 12 forbids ranking claims by wrongness and persuasive framing, so the owner's top-10-common-lies request is served as the references order with the state filter set to CONTRADICTED, in neutral wording, and will never be titled lies."}], "edges": [{"source": "implementation_implemented_claim_references_claim_references", "target": "app_models_c
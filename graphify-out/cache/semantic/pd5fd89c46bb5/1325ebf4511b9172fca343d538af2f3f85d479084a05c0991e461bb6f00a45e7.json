{"nodes": [{"id": "implementation_implemented_stage_08_agents_stage_8_agents", "label": "Stage 8 - Tasks, leases, packets, and the example agent", "file_type": "document", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_04_agent_protocol_agent_protocol", "label": "Spec 04 Agent Protocol", "file_type": "document", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_tasks_build_context_buildcontext", "label": "Tasks::BuildContext", "file_type": "code", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_tasks_lease_lease", "label": "Tasks::Lease", "file_type": "code", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_tasks_create_create", "label": "Tasks::Create", "file_type": "code", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_tasks_checks_checks", "label": "Tasks::Checks", "file_type": "code", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_tasks_types_types", "label": "Tasks::Types", "file_type": "code", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_tasks_packet_packet", "label": "Tasks::Packet", "file_type": "code", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_contributions_standing_standing", "label": "Contributions::Standing", "file_type": "code", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_contributions_schemas_schemas", "label": "Contributions::Schemas", "file_type": "code", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_models_task_task", "label": "Task", "file_type": "code", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_models_task_assignment_taskassignment", "label": "TaskAssignment", "file_type": "code", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_jobs_expire_leases_job_expireleasesjob", "label": "ExpireLeasesJob", "file_type": "code", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_ledger_appliers_task_result_taskresult", "label": "Ledger::Appliers::TaskResult", "file_type": "code", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_services_contributions_validate_task_result_validatetaskresult", "label": "Contributions::ValidateTaskResult", "file_type": "code", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_implemented_stage_08_agents_one_signed_packet_per_task", "label": "One signed packet per task", "file_type": "rationale", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blind multi-assignment (04 SS3.1) means literally identical packets, so the packet is built once at task creation and shared by every assignee and lease_expires_at lives on the assignment instead of inside the packet, a deviation from the 04 SS3 example that keeps one task_packet_hash per task."}, {"id": "implementation_implemented_stage_08_agents_blind_multi_assignment", "label": "Blind multi-assignment and its limit", "file_type": "rationale", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Task reads hide results until all slots submit or leases expire with none live, but the public log itself is not blind, which 04 SS3.1 cannot fully achieve on a transparency log; the gap is recorded rather than papered over."}, {"id": "implementation_implemented_stage_08_agents_server_never_fetches_agent_urls", "label": "Agent sources are metadata-only and the server never fetches", "file_type": "rationale", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "04 SS6 step 9 forbids server-side retrieval of agent-supplied URLs, so a source created inside a task is stored retrieval_pending with no content or content hash, and CHAR_RANGE locations are refused on such sources until content is imported."}, {"id": "implementation_implemented_stage_08_agents_per_result_acceptance_of_extractions", "label": "Acceptance is per result, not per claim", "file_type": "rationale", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "04 SS4.3 says each extracted claim, but per-claim acceptance would need row-level ACCEPT, which 02 SS1.1a does not define; results that only add objects are system-accepted, while extraction results and anything superseding another principal's work stay pending for a different principal, as one contribution."}, {"id": "implementation_implemented_stage_08_agents_per_op_checks_inside_the_append_transaction", "label": "Per-op semantic checks run inside the append transaction", "file_type": "rationale", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refs must resolve before the type-scope rules can be checked, so the checks run after resolution inside the transaction and a rejection rolls the whole append back: nothing is logged and no seq is consumed."}, {"id": "implementation_implemented_stage_08_agents_tasks_are_operational_tables", "label": "Tasks are operational tables, not projections", "file_type": "rationale", "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Task creation is not an action in the closed list, so replay leaves tasks and task_assignments alone; the consequence is that GET /log alone does not carry task targets, so task-derived review checks need the public task registry. Recorded for the owner as a gap in log self-containment."}], "edges": [{"source": "implementation_implemented_stage_08_agents_stage_8_agents", "target": "app_services_tasks_build_context_buildcontext", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_08_agents_stage_8_agents", "target": "app_services_tasks_lease_lease", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_08_agents_stage_8_agents", "target": "app_services_tasks_create_create", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_08_agents_stage_8_agents", "target": "app_services_tasks_checks_checks", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_08_agents_stage_8_agents", "target": "app_services_tasks_types_types", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_08_agents_stage_8_agents", "target": "app_services_tasks_packet_packet", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_08_agents_stage_8_agents", "target": "app_services_contributions_standing_standing", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-08-agents.md", "source_location": null, "weight": 1.0}, {"source": "impleme
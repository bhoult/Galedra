{"nodes": [{"id": "implementation_implemented_stage_22_outline_share_stage", "label": "Stage 22 \u2014 Sharing and following an outline (implemented)", "file_type": "document", "source_file": "implementation/implemented/stage-22-outline-share.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The link posted for a checked speech should be as useful as the link for a checked meme, and someone who wants to help should be able to find the big jobs. An outline's investigation reads its claims live rather than from a frozen claim_ids list, so the shareable page follows the work."}, {"id": "implementation_implemented_stage_22_outline_share_share_line_form", "label": "The outline share line, fixed and without an adjective", "file_type": "rationale", "source_file": "implementation/implemented/stage-22-outline-share.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\"Checked in Galedra: <heading> \u00b7 N claims recorded, M checked \u00b7 <states in 06 \u00a76 order> \u00b7 <url>\" \u2014 counts in the spec's order and no adjective for the whole, because a speech is never given a verdict."}, {"id": "implementation_implemented_stage_22_outline_share_unfinished_outlines", "label": "Unfinished outlines on the weaknesses page", "file_type": "rationale", "source_file": "implementation/implemented/stage-22-outline-share.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Article XXII: an outline whose leaves are extracted but fewer than a quarter of whose claims carry any counted evidence is a big job left half done, and should be visible as such rather than reading as a finished check."}, {"id": "implementation_implemented_stage_22_outline_share_no_per_speaker_counts", "label": "No per-speaker counts inside one transcript", "file_type": "rationale", "source_file": "implementation/implemented/stage-22-outline-share.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Article XVIII: sections may be named by speaker, but no count is broken out by speaker, because a per-speaker tally is a speaker score by another name."}], "edges": [{"source": "implementation_implemented_stage_22_outline_share_stage", "target": "implementation_implemented_stage_22_outline_share_share_line_form", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-22-outline-share.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_22_outline_share_stage", "target": "implementation_implemented_stage_22_outline_share_unfinished_outlines", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-22-outline-share.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_22_outline_share_stage", "target": "implementation_implemented_stage_22_outline_share_no_per_speaker_counts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-22-outline-share.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_22_outline_share_stage", "target": "app_services_sections_progress_progress", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-22-outline-share.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_22_outline_share_share_line_form", "target": "app_services_sections_tree_tree", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-22-outline-share.md", "source_location": null, "weight": 1.0}, {"source": "
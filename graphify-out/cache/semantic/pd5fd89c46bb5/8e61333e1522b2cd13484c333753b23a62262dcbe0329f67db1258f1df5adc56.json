{"nodes": [{"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_1", "label": "Invariant 1 \u2014 Log First", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every epistemic mutation is a signed contribution appended through Ledger::Append; projections are written only by Ledger::Apply."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_2", "label": "Invariant 2 \u2014 Replayable", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Truncating projections and replaying the log reproduces identical projections and snapshot digests."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_3", "label": "Invariant 3 \u2014 Append-Only", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepted history is never silently rewritten; corrections are new contributions."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_4", "label": "Invariant 4 \u2014 Deterministic, Versioned Scores", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same seq plus same model yields a byte-identical trace; scorer code changes require a new model version."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_5", "label": "Invariant 5 \u2014 Unknown Is Explicit", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NOT_APPLICABLE and INSUFFICIENT_EVIDENCE carry no probability anywhere; a directional state needs evidence in that direction."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_6", "label": "Invariant 6 \u2014 No Double Counting", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dependent evidence is suppressed per independence group and direction, visibly in the trace."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_7", "label": "Invariant 7 \u2014 AI Is Never Evidence By Itself", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MODEL_OUTPUT weighs 0; agent results are closed-enum ops that pass validation and remain auditable."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_8", "label": "Invariant 8 \u2014 Reputation Is Audit-Derived and Not a Scoring Input", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Task- and domain-specific, and deliberately stronger than Article X requires: reputation does not enter claim scores at all in v0.1."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_9", "label": "Invariant 9 \u2014 No Self-Certification", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No certification by the same contributor or the same principal."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_10", "label": "Invariant 10 \u2014 Summaries Only Restate Supplied Graph Content", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every sentence of a summary cites graph IDs."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_11", "label": "Invariant 11 \u2014 Untrusted Text Stays Inert", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contributor notes and excerpts never reach scoring, and notes never reach another agent's packet; the server never fetches agent-supplied URLs."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_12", "label": "Invariant 12 \u2014 Moderation Is Visible", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quarantine and takedown leave public stubs; nothing disappears without a trace."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_13", "label": "Invariant 13 \u2014 Shared and Personal Stay Separate", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing user-specific or opinion-shaped is written to the log except as an ordinary evidence-bearing contribution."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_14", "label": "Invariant 14 \u2014 More Than One Model", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scoring code must never assume a single model; the second model exists to keep that honest."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_15", "label": "Invariant 15 \u2014 No Text-Uniqueness for Claims", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Similarity proposes relationships; only an accepted, reversible MERGE_CLAIMS merges."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_16", "label": "Invariant 16 \u2014 Answers First, Numbers on Request", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The default claim view is the answer card; probabilities sit behind Show calculation."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_17", "label": "Invariant 17 \u2014 Determinism Is Not Objectivity", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never describe a score as objective in UI copy, docs, or API field names."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_18", "label": "Invariant 18 \u2014 Galedra Runs No Model", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only Llm::Adapter is the deterministic stub; a function needing a model becomes a task or a tool for a connected assistant whose answer is a signed contribution open to audit."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_agent_handoff", "label": "AI Coding Agent Handoff", "file_type": "document", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Names the precedence order, the invariants, the required artifacts and the success standard, so a coding agent can start without re-deriving the project's commitments."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_order_of_work", "label": "Order of Work \u2014 Log First, UI Last", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phases 0\u20137 build the signed log, projections and scoring before any UI, because the v2 roadmap built CRUD tables first and contradicted the handoff; tests follow the same order (security, log and scoring before UI)."}, {"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_when_uncertain_rule", "label": "When Uncertain \u2014 Simplest Reversible Option", "file_type": "rationale", "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Choose the simplest reversible option that preserves the invariants, record it, and continue; stop only when a requirement is impossible or two requirements cannot both hold. Never 'fix' a golden value to make something pass."}], "edges": [{"source": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_1", "target": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_12_constitution_article_xiii", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "weight": 1.0}, {"source": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_2", "target": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_12_constitution_article_xx", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "weight": 1.0}, {"source": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_3", "target": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_12_constitution_article_xiii", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/epistemic-ledger-poc-spec-v4/epistemic-ledger-poc/10-agent-handoff.md", "source_location": null, "weight": 1.0}, {"source": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_10_agent_handoff_invariant_4", "target":
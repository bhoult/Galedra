{"nodes": [{"id": "docs_epistemic_ledger_poc_spec_v4_epistemic_ledger_poc_12_constitution_article_xix", "label": "Article XIX \u2014 Transparency over persuasion", "file_type": "concept", "source_file": "implementation/implemented/stage-24-admin-nav.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_implemented_stage_24_admin_nav_stage", "label": "Stage 24 \u2014 Admins, help, and navigation (implemented)", "file_type": "document", "source_file": "implementation/implemented/stage-24-admin-nav.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admin is not a ledger role. The log already holds its powers, all signed and public; admin is about accounts and menus, which live outside the log, so it is a column on users with who granted it and when. Built together with Stage 23 on the owner's instruction."}, {"id": "implementation_implemented_stage_24_admin_nav_moderator_appointment", "label": "Moderator appointment by an admin (a visible stopgap)", "file_type": "rationale", "source_file": "implementation/implemented/stage-24-admin-nav.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The reserved decision \u2014 who holds the system key and appoints moderators \u2014 still stands. The appointment is visible (meta lists every moderator key) but not in the log; when the owner decides, a signed APPOINT_MODERATOR control entry can replace the flag, and Governance::Moderators is the one reader."}, {"id": "implementation_implemented_stage_24_admin_nav_bug_reports", "label": "Bug reports, the sibling of feature requests", "file_type": "rationale", "source_file": "implementation/implemented/stage-24-admin-nav.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outside the log like feature requests, repeats within 30 days counted on one row, filed by assistants through report_bug (ten a day) or by people from Help, signed in or not (five an hour per address); guidance says when to use it against request_feature."}, {"id": "implementation_implemented_stage_24_admin_nav_about_page", "label": "/about and /licenses \u2014 what build is running and under what terms", "file_type": "rationale", "source_file": "implementation/implemented/stage-24-admin-nav.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Revision, repository, node address and key, log head, released models, moderator keys, data licence, and the constitution version and hash \u2014 Article XIX applied to the software itself. A REVISION file written at image build wins over git. Drop-downs use details/summary rather than a menu library: no dependency, works without JavaScript."}], "edges": [{"source": "implementation_implemented_stage_24_admin_nav_stage", "target": "implementation_implemented_stage_24_admin_nav_moderator_appointment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-24-admin-nav.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_24_admin_nav_stage", "target": "implementation_implemented_stage_24_admin_nav_bug_reports", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-24-admin-nav.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_24_admin_nav_stage", "target": "implementation_implemented_stage_24_admin_nav_about_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation/implemented/stage-24-admin-nav.md", "source_location": null, "weight": 1.0}, {"source": "implementation_implemented_stage_24_admin_nav_stage", "target":
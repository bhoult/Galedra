{"nodes": [{"id": "docs_research_research_notes", "label": "Research Notes \u2014 Adjacent Systems and Prior Art", "file_type": "document", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No mature system was found combining all the core ideas into a general-purpose, agent-native, auditable epistemic substrate; several solve parts well and should be interoperated with rather than reinvented."}, {"id": "docs_research_scite", "label": "Scite", "file_type": "concept", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Demonstrates that users value evidence-aware research tooling; citation-context classification is adjacent evidence, not an epistemic substrate."}, {"id": "docs_research_wikidata", "label": "Wikidata", "file_type": "concept", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Could reduce ontology work through entity identifiers."}, {"id": "docs_research_kialo", "label": "Kialo", "file_type": "concept", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Argument mapping; lessons about readers wanting conclusions and about moderation and capture."}, {"id": "docs_research_nanopublications", "label": "Nanopublications", "file_type": "concept", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closest publishing-format precedent; assertion, provenance and publication-info graphs are the intended P1 export mapping."}, {"id": "docs_research_w3c_prov", "label": "W3C PROV", "file_type": "concept", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contributions map to activities, agents and entities; export mapping planned for P1."}, {"id": "docs_research_claimreview", "label": "ClaimReview", "file_type": "concept", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Its reviewRating expects a verdict, which conflicts with model-conditional, no-verdict display; any use must be opt-in and carry state and model rather than a truth rating."}, {"id": "docs_research_orkg", "label": "Open Research Knowledge Graph (ORKG)", "file_type": "concept", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Possible source of structured candidate claims, evidence or identifiers."}, {"id": "docs_research_legal_citation_market", "label": "Legal Citation Verification Market", "file_type": "concept", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real market already paying for one-time citation checks; the lesson is which parts generalize outside legal research."}, {"id": "docs_research_rootclaim", "label": "Rootclaim", "file_type": "concept", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The closest precedent for the probabilistic layer, but oriented to producing an analysis, where the ledger preserves the reusable substrate from which many analyses can later be generated."}, {"id": "docs_research_reason_commons", "label": "Reason Commons", "file_type": "concept", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Philosophically the closest project found: it independently recognizes that useful reasoning disappears inside conversations and documents. Monitor closely as a potential collaborator."}, {"id": "docs_research_proofweave", "label": "Proofweave", "file_type": "concept", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Technically the closest example of the agent contribution model \u2014 delegated identity, signed envelopes, verification gates, append-only receipts \u2014 but its formal-mathematics verification guarantees do not generalize to empirical reasoning."}, {"id": "docs_research_portable_agent_memory", "label": "Portable Agent Memory", "file_type": "concept", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Converges independently on content addressing, cryptographic provenance and cross-model portability, but answers 'what does an agent remember' where the ledger asks 'why is this proposition warranted'."}, {"id": "docs_research_galed", "label": "GALED", "file_type": "concept", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A naming collision with a very close metaphor; the reason not to use plain 'GalEd' as the public brand."}, {"id": "docs_research_evidence_graph_projects", "label": "Evidence Graph / Claim Graph Projects", "file_type": "concept", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_argument_mapping_lessons", "label": "Lessons From Prior Argument-Mapping Projects", "file_type": "concept", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adoption fails on high contribution cost, benefits accruing to later users, readers wanting conclusions, and moderation and capture."}, {"id": "docs_research_claim_identity_open_problem", "label": "Claim Identity Is a Major Open Problem", "file_type": "rationale", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aggressive semantic deduplication destroys important distinctions and loose deduplication fragments evidence; semantic search should propose SAME_AS / NARROWS / BROADENS / QUALIFIES, and merging must be explicit, attributable, auditable and reversible."}, {"id": "docs_research_determinism_not_judgment_free", "label": "Determinism Does Not Eliminate Judgment", "file_type": "rationale", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Judgment remains in wording, relevance, support strength, interpretive distance, independence grouping and priors; the response is not to hide the subjectivity but to make it explicit, signed, challengeable, versioned and auditable."}, {"id": "docs_research_audit_economics", "label": "Audit Economics", "file_type": "rationale", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Volunteer AI compute is not automatically valuable: a low-quality agent may create more audit work than useful knowledge, so scheduling should net out audit and correction cost."}, {"id": "docs_research_correlated_ai_error", "label": "Correlated AI Error", "file_type": "rationale", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two AI agents are not necessarily independent \u2014 shared model family, training biases, retrieval sources and common hallucinations \u2014 so verification independence should be modeled separately from source independence."}, {"id": "docs_research_probabilities_and_public_ux", "label": "Probabilities and Public UX", "file_type": "rationale", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bare 0.73 is read as '73% true', which is too strong; default presentation should lead with state, coverage, stability and the main unresolved issue, with the calculation in an advanced view."}, {"id": "docs_research_recommended_public_demo", "label": "Recommended Public Demo \u2014 Citation Laundering, Missing Qualifier, AI Citation Hallucination", "file_type": "rationale", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Demonstrates value without making the project appear fringe-adjacent, which the ancient-text example risked."}, {"id": "docs_research_strategic_conclusion", "label": "Strategic Conclusion \u2014 Verified Once, Reusable Forever", "file_type": "rationale", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The differentiator is not that the system can check a citation, which many tools do, but that a successful verification becomes a durable epistemic object another person, document or agent can reuse and independently audit."}, {"id": "docs_research_long_term_architecture_position", "label": "Long-Term Architecture Position \u2014 An Integration Layer", "file_type": "rationale", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Become an integration layer over Scite, Wikidata, OpenAlex, nanopublications and PROV rather than attempting to replace existing infrastructure."}, {"id": "docs_research_questions_after_poc", "label": "Questions To Revisit After POC", "file_type": "rationale", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_working_conclusion", "label": "Working Conclusion \u2014 Do Not Sell the Check, Preserve the Check", "file_type": "rationale", "source_file": "docs/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build the missing integration layer while reusing existing standards; turn disposable AI research into durable, independently auditable epistemic infrastructure."}], "edges": [{"source": "docs_research_research_notes", "target": "docs_research_scite", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_research_notes", "target": "docs_research_wikidata", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_research_notes", "target": "docs_research_kialo", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_research_notes", "target": "docs_research_nanopublications", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_research_notes", "target": "docs_research_w3c_prov", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_research_notes", "target": "docs_research_claimreview", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0
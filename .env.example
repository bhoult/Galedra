# Copy to .env for local development. Loaded by dotenv in development and test,
# and by Docker Compose. Never commit .env.

# PostgreSQL (docker-compose.yml overrides DB_HOST=db inside the app container)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Run the Solid Queue supervisor inside Puma (one process serves web and jobs)
SOLID_QUEUE_IN_PUMA=true

# Ledger system key, Ed25519, base64url. Lives only in the environment, never the
# database (spec 05 §2). Used from Stage 1; generate with: bin/rails ledger:keygen
LEDGER_SYSTEM_PRIVATE_KEY=
LEDGER_SYSTEM_PUBLIC_KEY=

# Active Record Encryption (server-custodied contributor keys). Generate with:
#   bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Runtime connections switch to this restricted PostgreSQL role (no DELETE or
# TRUNCATE on contributions, UPDATE only on current_status). Set to "false" when
# connecting directly as such a role.
LEDGER_DB_APP_ROLE=galedra_app

# Moderator keys (comma-separated key ids). Moderators may quarantine, take
# down, suspend, and invalidate; the list is published by /api/v1/meta.
LEDGER_MODERATOR_KEY_IDS=

# The deterministic adapter for summaries, claim extraction, and affiliation
# deduplication. "stub" is the only value: Galedra runs no model. Assistants
# connected over MCP do the reading and reasoning and sign what they record.
LEDGER_LLM_ADAPTER=stub

# Serving from your own address (README "Serving it from home"). Hostnames the
# app answers to besides localhost, comma-separated; others get 403.
LEDGER_ALLOWED_HOSTS=
# Production only (compose.production.yaml): the domain Thruster provisions a
# Let's Encrypt certificate for, the credentials key, and the database name.
TLS_DOMAIN=
RAILS_MASTER_KEY=
DB_NAME=galedra_production
# Cloudflare named tunnel (compose.production.yaml, profile "tunnel"); the tunnel's
# public hostname goes in LEDGER_ALLOWED_HOSTS. For a quick test without an
# account: cloudflared tunnel --url http://localhost:3000, with
# LEDGER_ALLOWED_HOSTS=.trycloudflare.com
CLOUDFLARE_TUNNEL_TOKEN=
# The published ChatGPT GPT that fronts this ledger, linked from the connect page.
LEDGER_CHATGPT_GPT_URL=

# Stage 17: Galedra's own job fetches sources held by reference (public hosts
# only, 2 MB, 10 s, robots respected) and records what it found. "on" by
# default in development and production, "off" in test.
LEDGER_RETRIEVAL=on

# Which scoring model answers when a reader asks for none. Pinned on purpose:
# releasing a newer model must not change what the whole node reports without
# someone deciding to (Stage 35). Unset, the newest released model wins.
LEDGER_DEFAULT_MODEL=ledger-default@0.3.0

# Stage 40: record how long each controller action took, how many statements it
# issued, and how often it was asked for, in request_tallies and
# request_samples. Off by default; "on" costs one upsert per request and one
# extra row per request over 500 ms or 200 statements. It records no client
# address and no user identity. Pruned to 30 days by PruneRequestMetricsJob;
# `bin/rails 'metrics:clear[claims#show]'` drops an action's rows once it is
# fixed, and `bin/rails metrics:report` reads them.
LEDGER_REQUEST_METRICS=off

# Copy to .env for local development. Loaded by dotenv in development and test,
# and by Docker Compose. Never commit .env.

# PostgreSQL (docker-compose.yml overrides DB_HOST=db inside the app container)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Run the Solid Queue supervisor inside Puma (one process serves web and jobs)
SOLID_QUEUE_IN_PUMA=true

# Ledger system key, Ed25519, base64url. Lives only in the environment, never the
# database (spec 05 §2). Used from Stage 1; generate with: bin/rails ledger:keygen
LEDGER_SYSTEM_PRIVATE_KEY=
LEDGER_SYSTEM_PUBLIC_KEY=

# Active Record Encryption (server-custodied contributor keys). Generate with:
#   bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Runtime connections switch to this restricted PostgreSQL role (no DELETE or
# TRUNCATE on contributions, UPDATE only on current_status). Set to "false" when
# connecting directly as such a role.
LEDGER_DB_APP_ROLE=galedra_app

# Moderator keys (comma-separated key ids). Moderators may quarantine, take
# down, suspend, and invalidate; the list is published by /api/v1/meta.
LEDGER_MODERATOR_KEY_IDS=
